---
import { tiles, themes } from './home/slideshow-config';
import { tileDetails } from './home/tile-details-config';
import TileDetailModal from './TileDetailModal.astro';
---

<!-- Inject tiles data into window for inline script -->
<script is:inline define:vars={{ tiles, themes }}>
  window.TILES_DATA = tiles;
  window.THEMES_DATA = themes;
</script>

<div class="identity-hero">
  <div class="identity-container">
    
    <!-- Story Section -->
    <div class="story-section">
      <p class="story-eyebrow">Why Promptfull exists</p>
      <h1 class="story-headline">
        AI is powerful.<br/>
        Learning it shouldn't feel like work.
      </h1>
      <p class="story-paragraph">
        Promptfull helps you create better prompts without shortcuts or tricks.
        By understanding why prompts work,
        better results come naturally.
      </p>
      <p class="story-trust">Join 1,000+ people learning AI the human way</p>
    </div>

    <!-- Approach Label -->
    <div class="approach-label">
      <span>Our approach</span>
    </div>

    <!-- 4 Tiles -->
    <div class="tiles-grid">
      {tiles.map((tile: any) => (
        <div 
          class="tile" 
          data-tile-subject={tile.subject}
          style={`background: ${themes[tile.subject].bg};`}
        >
          <div class="tile-content">
            <div class="tile-icon" set:html={tile.icon}>
            </div>
            <h3 class="tile-heading">{tile.headline}</h3>
            <p class="tile-description">{tile.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
  <!-- END of identity-container -->

  <!-- Tile Detail Modals -->
  {Object.entries(tileDetails).map(([subject, detail]) => (
    <TileDetailModal
      subject={detail.subject}
      headline={detail.headline}
      content={detail.content}
      backgroundColor={themes[subject].bg}
    />
  ))}

</div>
<!-- END of identity-hero -->

<style>

 /* Story Section */
  .story-section {
    max-width: 800px;
    margin: 0 auto 80px;
    text-align: center;
  }

  .story-eyebrow {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6B7280;
    margin: 0 0 20px 0;
  }

  .story-headline {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #1F2937;
    margin: 0 0 24px 0;
  }

  .story-paragraph {
    font-size: 18px;
    line-height: 1.6;
    color: #4B5563;
    margin: 0 0 20px 0;
  }

  .story-paragraph em {
    font-style: italic;
    color: #1F2937;
    font-weight: 600;
  }

  .story-trust {
    font-size: 14px;
    color: #6B7280;
    margin: 0;
    font-weight: 500;
  }

  /* Approach Label */
  .approach-label {
    text-align: center;
    margin: 0 0 32px 0;
  }

  .approach-label span {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6B7280;
    padding: 8px 20px;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 20px;
  }

  /* Responsive for Story Section */
  @media (max-width: 1024px) {
    .story-headline {
      font-size: 40px;
    }

    .story-paragraph {
      font-size: 17px;
      line-height: 1.65;
    }

    .story-section {
      margin-bottom: 64px;
      max-width: 680px;
    }

    .approach-label {
      margin-bottom: 28px;
    }
  }

  @media (max-width: 640px) {
    .story-section {
      margin-bottom: 56px;
      padding: 0 18px;
      max-width: 100%;
    }

    .story-headline {
      font-size: 34px;
      margin-bottom: 20px;
    }

    .story-paragraph {
      font-size: 17px;
      line-height: 1.7;
      margin-bottom: 18px;
    }

    .story-trust {
      font-size: 13px;
    }

    .approach-label {
      margin-bottom: 24px;
    }

    .approach-label span {
      font-size: 12px;
      padding: 7px 18px;
    }
  }

  /* Container */
  .identity-hero {
    width: 100%;
    padding: 10px 20px 10px !important;
    max-width: 1400px;
    margin: 0 auto;
  }

  .identity-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Tiles Grid - 4 COLUMNS ON DESKTOP */
  .tiles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .tile {
    border-radius: 24px;
    padding: 36px 28px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) {
    .tile:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    }

    .tile:hover::before {
      opacity: 1;
    }
  }

  .tile-content {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .tile-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 18px;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile-icon svg {
    width: 44px;
    height: 44px;
    display: block;
  }

  .tile-heading {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff !important;
    margin: 0 0 10px 0;
    line-height: 1.3;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .tile-description {
    font-size: 15px;
    color: #ffffff !important;
    margin: 0;
    line-height: 1.5;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }

  /* ─── Structured tile: dark navy bg needs stronger white ─────── */
  .tile[data-tile-subject="structured"] .tile-heading {
    color: #ffffff !important;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  .tile[data-tile-subject="structured"] .tile-description {
    color: #ffffff !important;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .tile[data-tile-subject="structured"] .tile-icon {
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
  }

  /* Responsive - Tablet */
  @media (max-width: 1024px) {
    .tiles-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .tile {
      aspect-ratio: 1 / 1;
      min-height: auto;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 640px) {
    .identity-hero {
      padding: 40px 18px !important;
    }

    .tiles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .tile {
      padding: 28px 20px;
      aspect-ratio: 1 / 1;
      min-height: auto;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      border-radius: 18px;
    }

    .tile-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 14px;
    }

    .tile-icon svg {
      width: 36px;
      height: 36px;
    }

    .tile-heading {
      font-size: 17px;
      margin-bottom: 0;
    }

    .tile-description {
      display: none;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }

    .tile:hover {
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tiles = document.querySelectorAll('.tile');
    const modals = document.querySelectorAll('.tile-detail-modal');

    // Open modal when tile is clicked
    tiles.forEach(tile => {
      tile.addEventListener('click', () => {
        const subject = tile.getAttribute('data-tile-subject');
        const modal = document.getElementById(`modal-${subject}`);
        
        if (modal) {
          modal.classList.add('active');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Close modal functionality
    modals.forEach(modal => {
      const closeBtn = modal.querySelector('.modal-close');
      const backdrop = modal.querySelector('.modal-backdrop');

      closeBtn?.addEventListener('click', () => {
        closeModal(modal);
      });

      backdrop?.addEventListener('click', () => {
        closeModal(modal);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) {
          closeModal(modal);
        }
      });
    });

    function closeModal(modal: Element) {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });
</script>