---
import { getFaqForCategory } from '../data/faqConfig';
import ArticleFAQ from './ArticleFAQ.astro';
import PromptCopyCard from "./PromptCopyCard.astro";
import AppPromoCard from "./AppPromoCard.astro";
import SponsoredInsightCard from "./SponsoredInsightCard.astro";
import RecentInAI from "./RecentInAI.astro";
import ShareButton from "./ShareButton.astro";

type Article = {
  id: string;
  title: string;
  subtitle: string;
  category: string;
  categoryColorHex: string;
  readTime: string;
  relativeDateLabel: string;
  publishDate: string;
  imageURL: string | null;
  cover_image?: string | null;
  content: string;
  show_prompt_box?: boolean;
  prompt_content?: string;
  prompt_why_works?: string;
};

interface Props {
  article: Article;
  relatedArticles?: Article[];
}

const { article, relatedArticles = [] } = Astro.props as Props;

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL ?? import.meta.env.PUBLIC_DIRECTUS_URL ?? '';
const assetUrl = (id: string | null | undefined) =>
  id ? `${DIRECTUS_URL}/assets/${id}` : null;

const faqs = getFaqForCategory(article.category);

const hexRaw = (article.categoryColorHex || "#7C5CFF").toString().replace("#", "");
const hex = hexRaw.length === 6 ? hexRaw : "7C5CFF";
const r = parseInt(hex.slice(0, 2), 16);
const g = parseInt(hex.slice(2, 4), 16);
const b = parseInt(hex.slice(4, 6), 16);
const pillStyle = `--pill-r:${r};--pill-g:${g};--pill-b:${b};`;

const sponsoredContent = {
  title: "Master AI prompts in 30 days",
  description: "A structured course that teaches you practical prompt engineering techniques used by professionals.",
  url: "https://example.com/prompt-course",
  sponsor: "Sponsored"
};
---

<div class="article-layout">

  <!-- ── LEFT COLUMN ─────────────────────────────────────────────────────── -->
  <article class="article-main">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <!-- Smart back button: uses history.back() to preserve scroll position.
           Label updates via JS based on where the user came from. -->
      <button class="back-link" id="back-button" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M19 12H5m7 7l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span id="back-label">Back</span>
      </button>
    </nav>

    <header class="article-header">
      <span class="pill" style={pillStyle}>{article.category.toUpperCase()}</span>
      <h1 class="article-title">{article.title}</h1>
      <div class="article-meta">
        {article.publishDate && (
          <span class="meta-item"><span class="ico">📅</span><span>{article.publishDate}</span></span>
        )}
        {article.readTime && (
          <span class="meta-item"><span class="ico">🕒</span><span>{article.readTime}</span></span>
        )}
      </div>
    </header>

    {article.imageURL && (
      <div class="article-hero">
        <img src={article.imageURL} alt={article.title} loading="eager" />
      </div>
    )}

    {article.subtitle && <p class="article-subtitle">{article.subtitle}</p>}

    <div class="article-content" set:html={article.content} />

    <!-- On mobile: prompt box sits here (right after content) -->
    {article.show_prompt_box && article.prompt_content && (
      <div class="mobile-prompt-box">
        <PromptCopyCard
          title="Copy prompt"
          prompt={article.prompt_content}
          whyWorks={article.prompt_why_works}
        />
      </div>
    )}

    <!-- FAQ -->
    <ArticleFAQ faqs={faqs} />

    <!-- Share -->
    <div class="share-wrapper">
      <ShareButton
        title={article.title}
        url={`https://promptfull-ai.com/articles/${article.id}`}
        text={article.subtitle}
      />
    </div>

    <!-- Related articles -->
    {relatedArticles.length > 0 && (
      <aside class="related-section">
        <h2 class="related-title">Related Articles</h2>
        <div class="related-grid">
          {relatedArticles.map((related: Article) => (
            <a href={`/articles/${related.id}`} class="related-card">
              {assetUrl(related.cover_image) && (
                <div class="related-card-thumb">
                  <img src={assetUrl(related.cover_image)!} alt={related.title} loading="lazy" />
                </div>
              )}
              <div class="related-card-body">
                <span class="related-category" style={`--pill-r:${parseInt((related.categoryColorHex||'7C5CFF').replace('#','').slice(0,2), 16)};--pill-g:${parseInt((related.categoryColorHex||'7C5CFF').replace('#','').slice(2,4), 16)};--pill-b:${parseInt((related.categoryColorHex||'7C5CFF').replace('#','').slice(4,6), 16)};`}>
                  {related.category.toUpperCase()}
                </span>
                <h3 class="related-card-title">{related.title}</h3>
                <p class="related-card-subtitle">{related.subtitle}</p>
              </div>
            </a>
          ))}
        </div>
      </aside>
    )}

    <!-- Mobile-only rail modules (rendered in flow, after related) -->
    <div class="mobile-rail">
      <AppPromoCard />
      <SponsoredInsightCard
        title={sponsoredContent.title}
        description={sponsoredContent.description}
        url={sponsoredContent.url}
        sponsor={sponsoredContent.sponsor}
      />
      <RecentInAI timeframe="This week" moreUrl="/recent-in-ai" />
    </div>

  </article>

  <!-- ── RIGHT RAIL (desktop only — hidden via CSS, not display:none) ──── -->
  <aside class="article-rail" aria-hidden="true">
    <div class="rail-sticky">
      <div class="rail-module rail-app">
        <AppPromoCard />
      </div>

      {article.show_prompt_box && article.prompt_content && (
        <div class="rail-module rail-prompt">
          <PromptCopyCard
            title="Copy prompt"
            prompt={article.prompt_content}
            whyWorks={article.prompt_why_works}
          />
        </div>
      )}

      <div class="rail-module rail-sponsored">
        <SponsoredInsightCard
          title={sponsoredContent.title}
          description={sponsoredContent.description}
          url={sponsoredContent.url}
          sponsor={sponsoredContent.sponsor}
        />
      </div>

      <div class="rail-module rail-recent">
        <RecentInAI timeframe="This week" moreUrl="/recent-in-ai" />
      </div>
    </div>
  </aside>

</div>

<script>
  const button = document.getElementById('back-button');
  const label  = document.getElementById('back-label');

  if (button && label) {
    // Check where the user came from
    const referrer = document.referrer;
    const fromArticles = referrer.includes('/articles');
    const fromHome = !referrer || referrer === window.location.origin + '/' || referrer === window.location.origin;

    // Set the correct label
    if (fromArticles) {
      label.textContent = 'Back to Articles';
    } else {
      label.textContent = 'Back to Home';
    }

    // Navigate back — preserves scroll position on the previous page
    button.addEventListener('click', () => {
      if (fromHome || fromArticles) {
        history.back();
      } else {
        // Fallback for direct visits (e.g. shared links, new tab)
        window.location.href = '/';
      }
    });
  }
</script>

<style>
  /* ── Desktop: two-column grid ─────────────────────────────────────── */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 48px;
    align-items: start;
  }

  .article-main  { max-width: 800px; width: 100%; }
  .article-rail  { position: relative; }

  .rail-sticky {
    position: sticky;
    top: 100px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Mobile rail hidden on desktop */
  .mobile-rail         { display: none; }
  .mobile-prompt-box   { display: none; }

  /* Desktop rail: use grid column collapse instead of display:none
     so sticky positioning doesn't leak on mobile */
  @media (max-width: 820px) {
    .article-rail {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
  }

  /* ── Breadcrumb ───────────────────────────────────────────────────── */
  .breadcrumb  { margin-bottom: 20px; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    transition: opacity 0.2s ease;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .back-link:hover { opacity: 0.7; }

  /* ── Article header ───────────────────────────────────────────────── */
  .article-header  { margin-bottom: 28px; }

  .pill {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(var(--pill-r), var(--pill-g), var(--pill-b), 0.12);
    color: rgb(var(--pill-r), var(--pill-g), var(--pill-b));
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .article-title {
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 16px 0;
  }

  .article-subtitle {
    font-size: 21px;
    line-height: 1.4;
    color: var(--text-secondary);
    font-weight: 500;
    margin: 0 0 24px 0;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--glass-border);
  }

  .article-meta {
    display: flex;
    gap: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-tertiary);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ── Hero image ───────────────────────────────────────────────────── */
  .article-hero {
    margin-bottom: 28px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(120, 120, 128, 0.10);
    max-height: 400px;
  }
  .article-hero img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
  }

  /* ── Article body ─────────────────────────────────────────────────── */
  .article-content {
    font-size: 19px;
    line-height: 1.58;
    color: var(--text);
    letter-spacing: -0.003em;
  }
  .article-content :global(p)          { margin: 0 0 18px 0; }
  .article-content :global(h2)         { font-size: 32px; line-height: 1.2; letter-spacing: -0.022em; font-weight: 700; color: var(--text); margin: 32px 0 16px 0; }
  .article-content :global(h3)         { font-size: 24px; line-height: 1.3; letter-spacing: -0.016em; font-weight: 600; color: var(--text); margin: 24px 0 12px 0; }
  .article-content :global(ul),
  .article-content :global(ol)         { margin: 0 0 24px 0; padding-left: 28px; }
  .article-content :global(li)         { margin-bottom: 12px; line-height: 1.58; }
  .article-content :global(strong)     { font-weight: 600; color: var(--text); }
  .article-content :global(a)          { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(0,122,255,0.3); transition: border-color 0.2s ease; }
  .article-content :global(a:hover)    { border-bottom-color: var(--accent); }
  .article-content :global(blockquote) { margin: 32px 0; padding-left: 24px; border-left: 3px solid rgba(0,0,0,0.12); font-style: italic; color: var(--text-secondary); }
  .article-content :global(code)       { font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace; font-size: 0.9em; background: rgba(0,0,0,0.05); padding: 2px 6px; border-radius: 4px; }

  /* ── Related articles ─────────────────────────────────────────────── */
  .related-section { margin-top: 80px; }
  .related-title {
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 24px 0;
  }
  .related-grid { display: grid; gap: 20px; }

  .related-card {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    padding: 16px;
    border-radius: 16px;
    background: var(--glass-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border: 0.5px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
  }
  .related-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

  .related-card-thumb {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(120, 120, 128, 0.1);
  }
  .related-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .related-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .related-category {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(var(--pill-r), var(--pill-g), var(--pill-b), 0.12);
    color: rgb(var(--pill-r), var(--pill-g), var(--pill-b));
    align-self: flex-start;
  }

  .related-card-title {
    font-size: 15px;
    line-height: 1.35;
    letter-spacing: -0.012em;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-card-subtitle {
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Tablet ───────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .article-layout { grid-template-columns: 1fr 300px; gap: 32px; }
    .article-main   { max-width: 620px; }
  }

  /* ── Mobile ───────────────────────────────────────────────────────── */
  @media (max-width: 820px) {
    /* Switch to single column */
    .article-layout { display: block; }

    /* Show mobile-only elements */
    .mobile-rail        { display: flex; flex-direction: column; gap: 20px; margin-top: 32px; }
    .mobile-prompt-box  { display: block; margin-top: 28px; }

    .article-main   { max-width: 100%; }

    /* Typography */
    .article-title    { font-size: 32px; line-height: 1.1; margin: 0 0 12px 0; }
    .article-subtitle { font-size: 17px; line-height: 1.45; margin: 0 0 16px 0; }
    .article-meta     { font-size: 13px; }
    .pill             { font-size: 10px; padding: 4px 9px; margin-bottom: 14px; }
    .article-content  { font-size: 16px; line-height: 1.65; }
    .article-content :global(p)  { margin: 0 0 16px 0; }
    .article-content :global(h2) { font-size: 26px; line-height: 1.15; margin: 32px 0 14px 0; }
    .article-content :global(h3) { font-size: 21px; line-height: 1.25; margin: 24px 0 10px 0; }
    .article-content :global(ul),
    .article-content :global(ol) { margin: 0 0 16px 0; padding-left: 24px; }
    .article-content :global(li) { margin-bottom: 8px; }
    .article-hero     { margin-bottom: 12px; max-height: 260px; border-radius: 12px; }
    .article-hero img { max-height: 260px; }
    .breadcrumb       { margin-bottom: 10px; }
    .article-header   { margin-bottom: 12px; }
    .back-link        { font-size: 14px; }

    /* Related */
    .related-section   { margin-top: 40px; }
    .related-title     { font-size: 23px; margin-bottom: 14px; line-height: 1.15; }
    .related-card      { padding: 14px; border-radius: 12px; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .related-card-title   { font-size: 14px; }
    .related-card-subtitle { font-size: 13px; }
  }

  /* ── Small mobile ─────────────────────────────────────────────────── */
  @media (max-width: 520px) {
    .article-title    { font-size: 28px; margin: 0 0 10px 0; }
    .article-subtitle { font-size: 16px; margin: 0 0 14px 0; }
    .pill             { font-size: 10px; padding: 3px 8px; margin-bottom: 12px; }
    .article-hero     { margin-bottom: 10px; max-height: 220px; border-radius: 10px; }
    .article-hero img { max-height: 220px; }
    .article-content  { font-size: 15.5px; }
    .article-content :global(p)  { margin: 0 0 14px 0; }
    .article-content :global(h2) { font-size: 24px; margin: 28px 0 12px 0; }
    .article-content :global(h3) { font-size: 19px; margin: 20px 0 10px 0; }
    .article-content :global(ul),
    .article-content :global(ol) { margin: 0 0 14px 0; padding-left: 20px; }
    .article-content :global(li) { margin-bottom: 6px; }
    .related-title    { font-size: 21px; margin-bottom: 12px; }
    .related-card     { padding: 14px; }
    .related-card-title   { font-size: 13px; }
    .related-card-subtitle { font-size: 12px; }
    .back-link        { font-size: 13px; }
    .article-meta     { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card { transition: none; }
    .related-card:hover { transform: none; }
  }
</style>