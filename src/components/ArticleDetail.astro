---
// Article detail component with 2-column layout
type Article = {
  id: string;
  title: string;
  subtitle: string;
  category: string;
  categoryColorHex: string;
  readTime: string;
  relativeDateLabel: string;
  publishDate: string;
  imageURL: string | null;
  content: string;
  show_prompt_box?: boolean;
  prompt_content?: string;
  prompt_why_works?: string;
};

interface Props {
  article: Article;
  relatedArticles?: Article[];
}

const { article, relatedArticles = [] } = Astro.props as Props;

// Color for category pill
const hexRaw = (article.categoryColorHex || "#7C5CFF").toString().replace("#", "");
const hex = hexRaw.length === 6 ? hexRaw : "7C5CFF";
const r = parseInt(hex.slice(0, 2), 16);
const g = parseInt(hex.slice(2, 4), 16);
const b = parseInt(hex.slice(4, 6), 16);
const pillStyle = `--pill-r:${r};--pill-g:${g};--pill-b:${b};`;

// Mock sponsored content - later from ad network
const sponsoredContent = {
  title: "Master AI prompts in 30 days",
  description: "A structured course that teaches you practical prompt engineering techniques used by professionals.",
  url: "https://example.com/prompt-course",
  sponsor: "Sponsored"
};

import PromptCopyCard from "./PromptCopyCard.astro";
import AppPromoCard from "./AppPromoCard.astro";
import SponsoredInsightCard from "./SponsoredInsightCard.astro";
import RecentInAI from "./RecentInAI.astro";
import ShareButton from "./ShareButton.astro";
---

<div class="article-layout">
  <!-- Left column: main content -->
  <article class="article-main">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M19 12H5m7 7l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Back to Home</span>
      </a>
    </nav>

    <!-- Article header -->
    <header class="article-header">
      <span class="pill" style={pillStyle}>
        {article.category.toUpperCase()}
      </span>
      
      <h1 class="article-title">{article.title}</h1>
      
      <div class="article-meta">
        {article.publishDate && (
          <span class="meta-item">
            <span class="ico">📅</span>
            <span>{article.publishDate}</span>
          </span>
        )}
        {article.readTime && (
          <span class="meta-item">
            <span class="ico">🕒</span>
            <span>{article.readTime}</span>
          </span>
        )}
      </div>
    </header>

    <!-- Hero image -->
    {article.imageURL && (
      <div class="article-hero">
        <img src={article.imageURL} alt={article.title} loading="eager" />
      </div>
    )}

    <!-- Subtitle/Excerpt -->
    {article.subtitle && (
      <p class="article-subtitle">{article.subtitle}</p>
    )}

    <!-- Article content -->
    <div class="article-content" set:html={article.content} />

    <!-- Share button -->
    <ShareButton 
      title={article.title}
      url={`https://promptfull-ai.com/articles/${article.id}`}
      text={article.subtitle}
    />

    <!-- Related articles -->
    {relatedArticles.length > 0 && (
      <aside class="related-section">
        <h2 class="related-title">Related Articles</h2>
        <div class="related-grid">
          {relatedArticles.map((related: Article) => (
            <a href={`/articles/${related.id}`} class="related-card">
              <span class="related-category" style={`--pill-r:${parseInt(related.categoryColorHex.slice(1,3), 16)};--pill-g:${parseInt(related.categoryColorHex.slice(3,5), 16)};--pill-b:${parseInt(related.categoryColorHex.slice(5,7), 16)};`}>
                {related.category.toUpperCase()}
              </span>
              <h3 class="related-card-title">{related.title}</h3>
              <p class="related-card-subtitle">{related.subtitle}</p>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>

  <!-- Right rail: sticky sidebar -->
  <aside class="article-rail">
    <div class="rail-sticky">
      <!-- App promo card -->
      <div class="rail-module rail-app">
        <AppPromoCard />
      </div>

      <!-- Prompt copy card (conditional from Directus) -->
      {article.show_prompt_box && article.prompt_content && (
        <div class="rail-module rail-prompt">
          <PromptCopyCard 
            title="Copy prompt"
            prompt={article.prompt_content}
            whyWorks={article.prompt_why_works}
          />
        </div>
      )}

      <!-- Sponsored insight (ad slot) -->
      <div class="rail-module rail-sponsored">
        <SponsoredInsightCard 
          title={sponsoredContent.title}
          description={sponsoredContent.description}
          url={sponsoredContent.url}
          sponsor={sponsoredContent.sponsor}
        />
      </div>

      <!-- Recent in AI (not sticky, scrolls naturally) -->
      <div class="rail-module rail-recent">
        <RecentInAI 
          timeframe="This week"
          moreUrl="/recent-in-ai" 
        />
      </div>
    </div>
  </aside>
</div>

<style>
  /* Desktop: Two-column grid layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 48px;
    align-items: start;
  }

  /* Main article column */
  .article-main {
    max-width: 800px;
    width: 100%;
  }

  /* Right rail */
  .article-rail {
    position: relative;
  }

  .rail-sticky {
    position: sticky;
    top: 100px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .rail-module {
    display: block;
  }

  /* Breadcrumb */
  .breadcrumb {
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 0.7;
  }

  /* Article header */
  .article-header {
    margin-bottom: 48px;
  }

  .pill {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(var(--pill-r), var(--pill-g), var(--pill-b), 0.12);
    color: rgb(var(--pill-r), var(--pill-g), var(--pill-b));
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .article-title {
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 16px 0;
  }

  .article-subtitle {
    font-size: 21px;
    line-height: 1.4;
    color: var(--text-secondary);
    margin: 0 0 20px 0;
  }

  .article-meta {
    display: flex;
    gap: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-tertiary);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Hero image */
  .article-hero {
    margin-bottom: 48px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(120, 120, 128, 0.10);
    max-height: 400px;
  }

  .article-hero img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
  }

  /* Article content - Apple reading experience */
  .article-content {
    font-size: 19px;
    line-height: 1.58;
    color: var(--text);
    letter-spacing: -0.003em;
  }

  .article-content :global(p) {
    margin: 0 0 24px 0;
  }

  .article-content :global(h2) {
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.022em;
    font-weight: 700;
    color: var(--text);
    margin: 48px 0 20px 0;
  }

  .article-content :global(h3) {
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.016em;
    font-weight: 600;
    color: var(--text);
    margin: 36px 0 16px 0;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 24px 0;
    padding-left: 28px;
  }

  .article-content :global(li) {
    margin-bottom: 12px;
    line-height: 1.58;
  }

  .article-content :global(strong) {
    font-weight: 600;
    color: var(--text);
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 122, 255, 0.3);
    transition: border-color 0.2s ease;
  }

  .article-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .article-content :global(blockquote) {
    margin: 32px 0;
    padding-left: 24px;
    border-left: 3px solid rgba(0, 0, 0, 0.12);
    font-style: italic;
    color: var(--text-secondary);
  }

  .article-content :global(code) {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.9em;
    background: rgba(0, 0, 0, 0.05);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Related articles */
  .related-section {
    margin-top: 80px;
    padding-top: 48px;
    border-top: 1px solid var(--separator);
  }

  .related-title {
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 24px 0;
  }

  .related-grid {
    display: grid;
    gap: 20px;
  }

  .related-card {
    display: block;
    padding: 24px;
    border-radius: 16px;
    background: var(--glass-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border: 0.5px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .related-category {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(var(--pill-r), var(--pill-g), var(--pill-b), 0.12);
    color: rgb(var(--pill-r), var(--pill-g), var(--pill-b));
    margin-bottom: 12px;
  }

  .related-card-title {
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.016em;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 8px 0;
  }

  .related-card-subtitle {
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tablet: narrower rail */
  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: 1fr 300px;
      gap: 32px;
    }

    .article-main {
      max-width: 620px;
    }
  }

  /* Mobile: single column with reordered modules */
  @media (max-width: 820px) {
    .article-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }

    .article-main {
      display: contents; /* Flatten so children become grid items */
    }

    .article-rail {
      display: contents; /* Flatten so children become grid items */
    }

    .rail-sticky {
      display: contents; /* Flatten completely */
    }

    /* Order all elements */
    .breadcrumb { order: 1; }
    .article-header { order: 2; }
    .article-hero { order: 3; }
    .article-subtitle { order: 4; }
    .article-content { order: 5; }
    
    /* Share button - encourage sharing right after reading */
    .share-section {order: 6;
      margin: 40px 0 0 0;
    }
    
    /* Prompt card right after share - "key takeaway" */
    .rail-prompt { 
      order: 7; 
      margin: 40px 0 32px 0;
    }
    
    /* Related articles - keep them engaged */
    .related-section { 
      order: 8;
      margin-top: 0px;
    }
    
    /* App promo - convert engaged readers */
    .rail-app { 
      order: 9; 
      margin: 40px 0 24px 0;
    }
    
    /* Sponsored - higher visibility, better performance */
    .rail-sponsored { 
      order: 10; 
      margin: 24px 0;
    }
    
    /* Recent in AI - bonus content at the end */
    .rail-recent { 
      order: 11; 
      margin: 24px 0;
    }

    /* Typography adjustments */
    .article-title {
      font-size: 34px;
      line-height: 1.12;
    }

    .article-subtitle {
      font-size: 18px;
      line-height: 1.5;
    }

    .article-meta {
      font-size: 13px;
    }

    /* Content typography */
    .article-content {
      font-size: 17px;
      line-height: 1.7;
    }

    .article-content :global(p) {
      margin: 0 0 20px 0;
    }

    .article-content :global(h2) {
      font-size: 28px;
      margin: 40px 0 18px 0;
    }

    .article-content :global(h3) {
      font-size: 22px;
      margin: 32px 0 14px 0;
    }

    /* Hero image - reduced height */
    .article-hero {
      margin-bottom: 32px;
      max-height: 280px;
      border-radius: 12px;
    }

    .article-hero img {
      max-height: 280px;
    }

    /* Related articles */
    .related-section {
      margin-top: 56px;
      padding-top: 32px;
    }

    .related-title {
      font-size: 24px;
      margin-bottom: 20px;
    }

    .related-card {
      padding: 20px;
      border-radius: 12px;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .related-card-title {
      font-size: 17px;
    }

    .related-card-subtitle {
      font-size: 14px;
    }

    /* Spacing adjustments */
    .breadcrumb {
      margin-bottom: 28px;
    }

    .article-header {
      margin-bottom: 32px;
    }
  }

  /* Small mobile (iPhone SE) */
  @media (max-width: 520px) {
    .breadcrumb {
      margin-bottom: 24px;
    }

    .article-header {
      margin-bottom: 28px;
    }

    .article-title {
      font-size: 30px;
    }

    .article-subtitle {
      font-size: 17px;
    }

    .article-hero {
      margin-bottom: 28px;
      max-height: 240px;
      border-radius: 12px;
    }

    .article-hero img {
      max-height: 240px;
    }

    .article-content {
      font-size: 16.5px;
    }

    .article-content :global(p) {
      margin: 0 0 18px 0;
    }

    .article-content :global(h2) {
      font-size: 26px;
      margin: 36px 0 16px 0;
    }

    .article-content :global(h3) {
      font-size: 20px;
      margin: 28px 0 12px 0;
    }

    .rail-prompt {
      margin: 28px 0;
    }

    .rail-recent {
      margin: 28px 0 0 0;
    }

    .rail-sponsored {
      margin: 20px 0;
    }

    .related-section {
      margin-top: 48px;
      padding-top: 28px;
    }

    .related-title {
      font-size: 22px;
    }

    .related-card {
      padding: 18px;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .related-card {
      transition: none;
    }

    .related-card:hover {
      transform: none;
    }
  }
</style>
