---
// src/components/FeaturedArticle.astro
const { article } = Astro.props;

// kleur uit hex (fallback)
const hexRaw = (article.categoryColorHex || "#7C5CFF").toString().replace("#", "");
const hex = hexRaw.length === 6 ? hexRaw : "7C5CFF";
const r = parseInt(hex.slice(0, 2), 16);
const g = parseInt(hex.slice(2, 4), 16);
const b = parseInt(hex.slice(4, 6), 16);

const pillStyle = `--pill-r:${r};--pill-g:${g};--pill-b:${b};`;
---

<article class="pf-featured" data-article-id={article.id} tabindex="0" role="button" aria-label={`Open ${article.title}`}>
  <div class="media">
    {article.imageURL ? (
      <img src={article.imageURL} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="media-fallback" aria-hidden="true">
        <span class="fallback-icon">🖼️</span>
      </div>
    )}
  </div>

  <div class="content">
    <span class="pill" style={pillStyle}>
      {String(article.category || "").toUpperCase()}
    </span>

    <h2 class="title">{article.title}</h2>
    <p class="subtitle">{article.subtitle}</p>

    <div class="meta">
      <span class="meta-item">
        <span class="ico">📅</span>
        <span>{article.relativeDateLabel}</span>
      </span>
      <span class="meta-item">
        <span class="ico">🕒</span>
        <span>{article.readTime}</span>
      </span>
    </div>
  </div>
</article>

<style>
  .pf-featured{
    border-radius: 28px;
    overflow: hidden;

    background: rgba(255,255,255,0.65);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 10px 34px rgba(0,0,0,0.10);
    border: 1px solid rgba(0,0,0,0.05);

    display: grid;
    grid-template-columns: 1.25fr 1fr; /* image groter dan tekst */
    min-height: 360px;

    cursor: pointer;
    outline: none;
  }

  .media{
    position: relative;
    min-height: 260px;
    background: rgba(120,120,128,0.12);
  }

  .media img,
  .media-fallback{
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .media-fallback{
    display: grid;
    place-items: center;
  }

  .fallback-icon{
    opacity: 0.6;
    font-size: 20px;
  }

  .content{
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pill{
    width: fit-content;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(var(--pill-r), var(--pill-g), var(--pill-b), 0.15);
    color: rgb(var(--pill-r), var(--pill-g), var(--pill-b));
  }

  .title{
    margin: 2px 0 0 0;
    font-size: 30px;
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 760;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .subtitle{
    margin: 0;
    font-size: 16px;
    line-height: 1.42;
    color: rgba(60,60,67,0.78);

    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta{
    margin-top: auto;
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: rgba(60,60,67,0.70);
  }

  .meta-item{
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .pf-featured:focus-visible{
    box-shadow:
      0 10px 34px rgba(0,0,0,0.10),
      0 0 0 4px rgba(0,122,255,0.18);
  }

  /* Responsive: stack op mobiel */
  @media (max-width: 820px){
    .pf-featured{
      grid-template-columns: 1fr;
    }
    .media{
      min-height: 240px;
    }
    .title{
      font-size: 26px;
    }
  }
</style>
