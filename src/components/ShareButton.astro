---
interface Props {
  title: string;
  url: string;
  text?: string;
}

const { title, url, text } = Astro.props;

// Encode for URLs
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedText = encodeURIComponent(text || title);

// Platform share URLs
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
const emailSubject = encodeURIComponent(`Check out: ${title}`);
const emailBody = encodeURIComponent(`I thought you might find this interesting:\n\n${title}\n\n${text || ''}\n\nRead more: ${url}`);
const emailUrl = `mailto:?subject=${emailSubject}&body=${emailBody}`;
---

<div class="share-section">
  <h3 class="share-title">Share this article</h3>
  
  <div class="share-buttons">
    <!-- LinkedIn -->
    <a 
      href={linkedInUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="share-button linkedin"
      aria-label="Share on LinkedIn"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      <span>LinkedIn</span>
    </a>

    <!-- X (Twitter) -->
    <a 
      href={twitterUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="share-button twitter"
      aria-label="Share on X"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>X</span>
    </a>

    <!-- Email -->
    <a 
      href={emailUrl} 
      class="share-button email"
      aria-label="Share via Email"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m2 7 10 6 10-6"/>
      </svg>
      <span>Email</span>
    </a>

    <!-- Copy Link / Native Share -->
    <button 
      class="share-button copy-link" 
      data-url={url}
      data-title={title}
      data-text={text || ''}
      aria-label="Copy link or share"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
      <span class="copy-link-text">Copy link</span>
    </button>
  </div>
</div>

<!-- Toast notification -->
<div class="share-toast" role="alert" aria-live="polite">
  <span class="toast-text"></span>
</div>

<style>
  /* Share section */
  .share-section {
    margin: 48px 0 0 0;
    padding: 40px 0 20px 0; /* Bottom half of top for visual balance */
    border-top: 1px solid var(--separator);
  }

  .share-title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 20px 0;
    text-align: center;
  }

  /* Share buttons grid */
  .share-buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    max-width: 580px;
    margin: 0 auto;
  }

  /* Individual share button */
  .share-button {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 12px;
    border-radius: 12px;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    color: white;
    position: relative;
  }

  .share-button svg {
    flex-shrink: 0;
  }

  .share-button span {
    font-size: 13px;
    line-height: 1.2;
  }

  /* LinkedIn - brand blue */
  .share-button.linkedin {
    background: #0A66C2;
  }

  .share-button.linkedin:hover {
    background: #004182;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(10, 102, 194, 0.3);
  }

  /* X (Twitter) - black */
  .share-button.twitter {
    background: #000000;
  }

  .share-button.twitter:hover {
    background: #1a1a1a;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
  }

  /* Email - neutral gray */
  .share-button.email {
    background: #5E5E5E;
  }

  .share-button.email:hover {
    background: #404040;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(94, 94, 94, 0.3);
  }

  /* Copy Link - accent blue */
  .share-button.copy-link {
    background: var(--accent);
  }

  .share-button.copy-link:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 122, 255, 0.3);
  }

  .share-button:active {
    transform: translateY(0);
  }

  /* Toast notification */
  .share-toast {
    position: fixed;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.9);
    color: white;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    z-index: 2000;
    transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    max-width: 90vw;
    text-align: center;
  }

  .share-toast.show {
    bottom: 32px;
  }

  /* Tablet: 2x2 grid */
  @media (max-width: 820px) {
    .share-section {
      margin: 40px 0 0 0;
      padding: 32px 0 16px 0; /* Bottom half for visual balance */
    }

    .share-buttons {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      max-width: 400px;
    }

    .share-button {
      padding: 14px 10px;
    }
  }

  /* Small mobile: single column */
  @media (max-width: 520px) {
    .share-section {
      margin: 32px 0 0 0;
      padding: 28px 0 14px 0; /* Bottom half for visual balance */
    }

    .share-title {
      font-size: 16px;
      margin-bottom: 16px;
    }

    .share-buttons {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      max-width: 100%;
    }

    .share-button {
      padding: 12px 8px;
      font-size: 13px;
    }

    .share-button span {
      font-size: 12px;
    }

    .share-button svg {
      width: 18px;
      height: 18px;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .share-button {
      transition: none;
    }

    .share-button:hover {
      transform: none;
    }

    .share-toast {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyButton = document.querySelector('.share-button.copy-link');
    const toast = document.querySelector('.share-toast');
    const toastText = toast?.querySelector('.toast-text');
    const copyLinkText = copyButton?.querySelector('.copy-link-text');

    if (!copyButton) return;

    // Show toast helper
    const showToast = (message: string) => {
      if (!toast || !toastText) return;
      
      toastText.textContent = message;
      toast.classList.add('show');
      
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    };

    copyButton.addEventListener('click', async () => {
      const htmlButton = copyButton as HTMLElement;
      const url = htmlButton.getAttribute('data-url') || window.location.href;
      const title = htmlButton.getAttribute('data-title') || '';
      const text = htmlButton.getAttribute('data-text') || '';

      // Button press animation
      htmlButton.style.transform = 'scale(0.95)';
      setTimeout(() => {
        htmlButton.style.transform = '';
      }, 150);

      // Check if Web Share API is available (mobile)
      if (navigator.share) {
        try {
          await navigator.share({
            title: title,
            text: text,
            url: url
          });
          // Successfully shared - no toast needed
        } catch (err) {
          // User cancelled or error occurred
          if ((err as Error).name !== 'AbortError') {
            console.error('Share failed:', err);
            fallbackCopy(url);
          }
        }
      } else {
        // Desktop: copy link to clipboard
        fallbackCopy(url);
      }
    });

    // Fallback: copy to clipboard
    const fallbackCopy = async (url: string) => {
      try {
        await navigator.clipboard.writeText(url);
        if (copyLinkText) {
          const originalText = copyLinkText.textContent;
          copyLinkText.textContent = 'Copied!';
          setTimeout(() => {
            copyLinkText.textContent = originalText;
          }, 2000);
        }
        showToast('✓ Link copied to clipboard!');
      } catch (err) {
        console.error('Failed to copy link:', err);
        showToast('Unable to copy. Please copy the URL manually.');
      }
    };
  });
</script>