---
// Tile Detail Modal - shows detail view for each tile
interface Props {
  subject: string;
  headline: string;
  content: string;
  backgroundColor: string;
}

const { subject, headline, content, backgroundColor } = Astro.props;

// Convert **bold** markers to <strong> tags
const formattedContent = content
  .split('\n\n')
  .map(paragraph => {
    const formatted = paragraph.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    return `<p>${formatted}</p>`;
  })
  .join('');
---

<div 
  class="tile-detail-modal" 
  id={`modal-${subject}`}
  data-subject={subject}
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <div class="modal-backdrop"></div>
  
  <div class="modal-panel" style={`background: ${backgroundColor};`}>
    <!-- Close button -->
    <button class="modal-close" aria-label="Close detail view">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Content -->
    <div class="modal-content">
      <h2 class="modal-headline">{headline}</h2>
      <div class="modal-text" set:html={formattedContent} />
    </div>
  </div>
</div>

<style>
  .tile-detail-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .tile-detail-modal.active {
    display: flex;
    opacity: 1;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    cursor: pointer;
  }

  .modal-panel {
    position: relative;
    width: 90%;
    max-width: 700px;
    padding: 60px 50px;
    border-radius: 32px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    transform: scale(0.9);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow-y: auto;
    max-height: 85vh;
  }

  .tile-detail-modal.active .modal-panel {
    transform: scale(1);
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 100;
    width: 48px;
    height: 48px;
    border: none;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .modal-close:hover {
    background: rgba(0, 0, 0, 0.5);
    transform: scale(1.1) rotate(90deg);
  }

  .modal-content {
    color: white;
  }

  .modal-headline {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 32px 0;
    color: white;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }

  .modal-text {
    font-size: 19px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }

  .modal-text :global(p) {
    margin: 0 0 20px 0;
  }

  .modal-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .modal-text :global(strong) {
    font-weight: 700;
    color: white;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .modal-panel {
      width: 94%;
      max-width: none;
      padding: 50px 32px;
      border-radius: 24px;
      max-height: 90vh;
    }

    .modal-headline {
      font-size: 32px;
      margin-bottom: 24px;
    }

    .modal-text {
      font-size: 17px;
      line-height: 1.65;
    }

    .modal-text :global(p) {
      margin: 0 0 16px 0;
    }

    .modal-close {
      width: 44px;
      height: 44px;
      top: 16px;
      right: 16px;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .modal-panel {
      transition: none;
    }

    .modal-close:hover {
      transform: scale(1.1);
    }
  }
</style>