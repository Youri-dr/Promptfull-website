---
interface Props {
title?: string;
subtitle?: string;
appStoreUrl?: string;
}
const { 
title = "Get Promptfull for iOS",
subtitle = "Access your prompts anywhere. Available now on the App Store.",
appStoreUrl = "https://apps.apple.com/app/promptfull"
} = Astro.props;
---
<div class="app-promo-card">
<!-- App icon -->
<div class="app-icon">
  <div class="app-icon-wrapper">
    <img src="/images/promptfull-favicon.svg" alt="Promptfull App Icon" class="app-icon-img" />
  </div>
</div>
<!-- Text content -->
<div class="app-content">
<h3 class="app-title">{title}</h3>
<p class="app-subtitle">{subtitle}</p>
</div>
<!-- App Store button -->
<a href={appStoreUrl} class="app-store-button" target="_blank" rel="noopener noreferrer">
<svg width="120" height="40" viewBox="0 0 120 40" fill="none">
<rect width="120" height="40" rx="8" fill="black"/>
<!-- Simplified App Store badge -->
<text x="60" y="24" text-anchor="middle" fill="white" font-size="14" font-weight="600" font-family="system-ui">
        Download
</text>
</svg>
<span class="sr-only">Download on the App Store</span>
</a>
</div>

<style>
.app-promo-card {
padding: 24px;
border-radius: 20px;
background: rgba(120, 120, 128, 0.08);
border: 0.5px solid rgba(0, 0, 0, 0.06);
box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
display: flex;
flex-direction: column;
gap: 16px;
align-items: center;
text-align: center;
  }
.app-icon {
display: flex;
align-items: center;
justify-content: center;
  }
.app-icon-wrapper {
  display: inline-flex;
  padding: 6px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12), 0 1px 3px rgba(0, 0, 0, 0.06);
}

.app-icon-img {
  width: 72px;
  height: 72px;
  display: block;
}
.app-content {
display: flex;
flex-direction: column;
gap: 6px;
  }
.app-title {
font-size: 19px;
font-weight: 600;
letter-spacing: -0.01em;
color: var(--text);
margin: 0;
  }
.app-subtitle {
font-size: 14px;
line-height: 1.4;
color: var(--text-secondary);
margin: 0;
  }
.app-store-button {
display: inline-block;
transition: transform 0.2s ease, opacity 0.2s ease;
  }
.app-store-button:hover {
transform: scale(1.05);
opacity: 0.9;
  }
.app-store-button:active {
transform: scale(0.98);
  }
.sr-only {
position: absolute;
width: 1px;
height: 1px;
padding: 0;
margin: -1px;
overflow: hidden;
clip: rect(0, 0, 0, 0);
white-space: nowrap;
border: 0;
  }
/* Mobile adjustments */
@media (max-width: 520px) {
.app-promo-card {
padding: 20px;
    }
.app-title {
font-size: 17px;
    }
.app-subtitle {
font-size: 13px;
    }
  }
</style>