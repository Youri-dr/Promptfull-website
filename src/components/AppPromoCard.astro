---
interface Props {
  title?: string;
  subtitle?: string;
  appStoreUrl?: string;
}

const { 
  title = "Get Promptfull for iOS",
  subtitle = "Access your prompts anywhere. Available now on the App Store.",
  appStoreUrl = "https://apps.apple.com/app/promptfull"
} = Astro.props;
---

<div class="app-promo-card">
  <!-- App icon placeholder -->
  <div class="app-icon">
    <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
      <rect width="56" height="56" rx="12" fill="url(#gradient)"/>
      <path d="M28 16l8 8-8 8m-8-8h16" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <defs>
        <linearGradient id="gradient" x1="0" y1="0" x2="56" y2="56">
          <stop offset="0%" stop-color="#7C5CFF"/>
          <stop offset="100%" stop-color="#5C3FD6"/>
        </linearGradient>
      </defs>
    </svg>
  </div>

  <!-- Text content -->
  <div class="app-content">
    <h3 class="app-title">{title}</h3>
    <p class="app-subtitle">{subtitle}</p>
  </div>

  <!-- App Store button -->
  <a href={appStoreUrl} class="app-store-button" target="_blank" rel="noopener noreferrer">
    <svg width="120" height="40" viewBox="0 0 120 40" fill="none">
      <rect width="120" height="40" rx="8" fill="black"/>
      <!-- Simplified App Store badge -->
      <text x="60" y="24" text-anchor="middle" fill="white" font-size="14" font-weight="600" font-family="system-ui">
        Download
      </text>
    </svg>
    <span class="sr-only">Download on the App Store</span>
  </a>
</div>

<style>
  .app-promo-card {
    padding: 24px;
    border-radius: 20px;
    background: rgba(120, 120, 128, 0.08);
    border: 0.5px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    text-align: center;
  }

  .app-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .app-title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0;
  }

  .app-subtitle {
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-secondary);
    margin: 0;
  }

  .app-store-button {
    display: inline-block;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .app-store-button:hover {
    transform: scale(1.05);
    opacity: 0.9;
  }

  .app-store-button:active {
    transform: scale(0.98);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile adjustments */
  @media (max-width: 520px) {
    .app-promo-card {
      padding: 20px;
    }

    .app-title {
      font-size: 17px;
    }

    .app-subtitle {
      font-size: 13px;
    }
  }
</style>