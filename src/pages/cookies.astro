---
// src/pages/cookies.astro
import PageTemplate from '../layouts/PageTemplate.astro';
---

<PageTemplate 
  title="Cookie Policy" 
  description="How Promptfull uses cookies and similar tracking technologies."
>
  <div class="cookies-page">
    <div class="cookies-container">
      <h1>Cookie Policy</h1>
      <p class="last-updated">Last updated: February 8, 2026</p>
      
      <div class="cookies-intro">
        <p>This Cookie Policy explains how Promptfull ("we," "us," or "our") uses cookies and similar tracking technologies when you visit our website at promptfull.com and use our mobile application.</p>
        <p>By continuing to use our Services, you consent to our use of cookies as described in this policy.</p>
      </div>

      <section class="cookies-section">
        <h2>1. What Are Cookies?</h2>
        <p>Cookies are small text files that are placed on your device (computer, smartphone, or tablet) when you visit a website or use an app. Cookies help websites remember information about your visit, making your experience more convenient and personalized.</p>
        
        <h3>Types of Technologies We Use</h3>
        <ul>
          <li><strong>Cookies:</strong> Small text files stored on your device</li>
          <li><strong>Web Beacons:</strong> Tiny graphics (also called "pixels" or "tags") embedded in web pages or emails</li>
          <li><strong>Local Storage:</strong> Technology that allows websites to store data locally on your device</li>
          <li><strong>Session Storage:</strong> Temporary storage that expires when you close your browser</li>
          <li><strong>Mobile Identifiers:</strong> Device-specific identifiers used in mobile applications</li>
        </ul>
      </section>

      <section class="cookies-section">
        <h2>2. Why We Use Cookies</h2>
        <p>We use cookies and similar technologies for several purposes:</p>
        <ul>
          <li><strong>Essential Functionality:</strong> Enable core features like user authentication and security</li>
          <li><strong>Performance Monitoring:</strong> Understand how visitors use our Services to improve functionality</li>
          <li><strong>Personalization:</strong> Remember your preferences and customize your experience</li>
          <li><strong>Analytics:</strong> Analyze usage patterns and measure the effectiveness of our Services</li>
          <li><strong>Security:</strong> Detect and prevent fraud, abuse, and security incidents</li>
          <li><strong>Advertising:</strong> Deliver relevant advertisements and measure campaign performance</li>
        </ul>
      </section>

      <section class="cookies-section">
        <h2>3. Types of Cookies We Use</h2>
        
        <h3>Essential Cookies (Strictly Necessary)</h3>
        <p>These cookies are necessary for our Services to function properly. They enable core functionality such as security, network management, and accessibility. You cannot opt out of these cookies.</p>
        
        <div class="cookie-table">
          <table>
            <thead>
              <tr>
                <th>Cookie Name</th>
                <th>Purpose</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>session_id</td>
                <td>Maintains your logged-in state</td>
                <td>Session</td>
              </tr>
              <tr>
                <td>csrf_token</td>
                <td>Protects against cross-site request forgery attacks</td>
                <td>Session</td>
              </tr>
              <tr>
                <td>cookie_consent</td>
                <td>Stores your cookie preferences</td>
                <td>1 year</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3>Performance and Analytics Cookies</h3>
        <p>These cookies help us understand how visitors interact with our Services by collecting and reporting information anonymously. This helps us improve our website and app.</p>
        
        <div class="cookie-table">
          <table>
            <thead>
              <tr>
                <th>Cookie Name</th>
                <th>Purpose</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>_ga</td>
                <td>Google Analytics - distinguishes users</td>
                <td>2 years</td>
              </tr>
              <tr>
                <td>_gid</td>
                <td>Google Analytics - distinguishes users</td>
                <td>24 hours</td>
              </tr>
              <tr>
                <td>_gat</td>
                <td>Google Analytics - throttles request rate</td>
                <td>1 minute</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3>Functional Cookies</h3>
        <p>These cookies enable enhanced functionality and personalization, such as remembering your preferences and settings.</p>
        
        <div class="cookie-table">
          <table>
            <thead>
              <tr>
                <th>Cookie Name</th>
                <th>Purpose</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>theme_preference</td>
                <td>Remembers your dark/light mode preference</td>
                <td>1 year</td>
              </tr>
              <tr>
                <td>language</td>
                <td>Stores your preferred language</td>
                <td>1 year</td>
              </tr>
              <tr>
                <td>user_settings</td>
                <td>Saves your personalized settings</td>
                <td>1 year</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3>Targeting and Advertising Cookies</h3>
        <p>These cookies are used to deliver advertisements that are relevant to you and your interests. They may also be used to limit the number of times you see an advertisement and measure the effectiveness of advertising campaigns.</p>
        
        <div class="cookie-table">
          <table>
            <thead>
              <tr>
                <th>Cookie Name</th>
                <th>Purpose</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>_fbp</td>
                <td>Facebook Pixel - tracks conversions and user behavior</td>
                <td>3 months</td>
              </tr>
              <tr>
                <td>IDE</td>
                <td>Google DoubleClick - serves targeted advertisements</td>
                <td>1 year</td>
              </tr>
              <tr>
                <td>ads_prefs</td>
                <td>Stores advertising preferences</td>
                <td>2 years</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="cookies-section">
        <h2>4. Third-Party Cookies</h2>
        <p>We use services from third-party companies that may set their own cookies to provide their services. These companies include:</p>
        
        <h3>Analytics Services</h3>
        <ul>
          <li><strong>Google Analytics:</strong> Helps us understand how visitors use our Services</li>
          <li><strong>Mixpanel:</strong> Tracks user interactions and product analytics</li>
          <li><strong>Amplitude:</strong> Provides behavioral analytics and insights</li>
        </ul>

        <h3>Advertising Services</h3>
        <ul>
          <li><strong>Google Ads:</strong> Delivers targeted advertisements</li>
          <li><strong>Facebook Pixel:</strong> Tracks conversions and retargeting</li>
          <li><strong>Twitter Ads:</strong> Measures ad campaign effectiveness</li>
        </ul>

        <h3>Social Media</h3>
        <ul>
          <li><strong>Facebook:</strong> Enables social sharing and integration</li>
          <li><strong>Twitter:</strong> Allows content sharing</li>
          <li><strong>LinkedIn:</strong> Professional network integration</li>
        </ul>

        <h3>Payment Processing</h3>
        <ul>
          <li><strong>Stripe:</strong> Processes subscription payments securely</li>
          <li><strong>Apple Pay:</strong> Handles in-app purchases on iOS</li>
        </ul>

        <p>These third parties have their own privacy policies governing their use of cookies. We recommend reviewing their policies:</p>
        <ul>
          <li><a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google Privacy Policy</a></li>
          <li><a href="https://www.facebook.com/privacy/policy/" target="_blank" rel="noopener">Facebook Privacy Policy</a></li>
          <li><a href="https://stripe.com/privacy" target="_blank" rel="noopener">Stripe Privacy Policy</a></li>
        </ul>
      </section>

      <section class="cookies-section">
        <h2>5. How to Manage Cookies</h2>
        
        <h3>Browser Settings</h3>
        <p>Most web browsers allow you to control cookies through their settings. You can:</p>
        <ul>
          <li>Delete all cookies stored on your device</li>
          <li>Block all cookies from being set</li>
          <li>Block third-party cookies only</li>
          <li>Clear cookies when you close your browser</li>
          <li>Set exceptions for specific websites</li>
        </ul>

        <h3>How to Control Cookies in Popular Browsers</h3>
        <ul>
          <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener">Google Chrome</a></li>
          <li><a href="https://support.mozilla.org/en-US/kb/enable-and-disable-cookies-website-preferences" target="_blank" rel="noopener">Mozilla Firefox</a></li>
          <li><a href="https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac" target="_blank" rel="noopener">Safari</a></li>
          <li><a href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" target="_blank" rel="noopener">Microsoft Edge</a></li>
        </ul>

        <h3>Mobile App Settings</h3>
        <p>You can control tracking in our mobile app through:</p>
        <ul>
          <li><strong>iOS:</strong> Settings → Privacy & Security → Tracking → Toggle off "Allow Apps to Request to Track"</li>
          <li><strong>Android:</strong> Settings → Google → Ads → Opt out of Ads Personalization</li>
          <li><strong>In-App:</strong> Settings → Privacy → Manage Cookie Preferences</li>
        </ul>

        <h3>Cookie Preference Center</h3>
        <p>You can manage your cookie preferences at any time using our Cookie Preference Center:</p>
        <div class="cookie-preferences-link">
          <button class="manage-cookies-btn" onclick="openCookiePreferences()">Manage Cookie Preferences</button>
        </div>

        <h3>Opt-Out Links</h3>
        <p>You can opt out of certain third-party cookies:</p>
        <ul>
          <li><a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics Opt-out</a></li>
          <li><a href="https://www.facebook.com/ads/preferences" target="_blank" rel="noopener">Facebook Ad Preferences</a></li>
          <li><a href="http://optout.networkadvertising.org/" target="_blank" rel="noopener">Network Advertising Initiative Opt-out</a></li>
          <li><a href="http://optout.aboutads.info/" target="_blank" rel="noopener">Digital Advertising Alliance Opt-out</a></li>
        </ul>

        <div class="warning-box">
          <p><strong>Important:</strong> Blocking or deleting cookies may impact your user experience and limit access to certain features of our Services. Essential cookies cannot be disabled as they are necessary for the Services to function.</p>
        </div>
      </section>

      <section class="cookies-section">
        <h2>6. Do Not Track Signals</h2>
        <p>Some browsers include a "Do Not Track" (DNT) feature that signals to websites that you do not want your online activities tracked. Our Services currently do not respond to DNT signals, as there is no universally accepted standard for how to interpret them.</p>
        <p>However, you can still control cookies through the methods described in Section 5 above.</p>
      </section>

      <section class="cookies-section">
        <h2>7. Cookies and Children</h2>
        <p>Our Services are not directed at children under 13, and we do not knowingly collect information from children through cookies. If you believe a child has provided us with information through cookies, please contact us at <a href="mailto:privacy@promptfull.com">privacy@promptfull.com</a>.</p>
      </section>

      <section class="cookies-section">
        <h2>8. Changes to This Cookie Policy</h2>
        <p>We may update this Cookie Policy from time to time to reflect changes in our practices, technologies, or legal requirements. We will notify you of any material changes by:</p>
        <ul>
          <li>Posting the updated Cookie Policy on this page</li>
          <li>Updating the "Last updated" date</li>
          <li>Displaying a prominent notice on our website or app</li>
        </ul>
        <p>We encourage you to review this Cookie Policy periodically to stay informed about how we use cookies.</p>
      </section>

      <section class="cookies-section">
        <h2>9. Contact Us</h2>
        <p>If you have questions about this Cookie Policy or our use of cookies, please contact us:</p>
        <div class="contact-info">
          <p><strong>Email:</strong> <a href="mailto:privacy@promptfull.com">privacy@promptfull.com</a></p>
          <p><strong>Privacy Team:</strong> <a href="mailto:dpo@promptfull.com">dpo@promptfull.com</a></p>
          <p><strong>Website:</strong> <a href="/contact">promptfull.com/contact</a></p>
        </div>
      </section>

      <div class="cookies-acknowledgment">
        <p><strong>By continuing to use Promptfull, you consent to our use of cookies as described in this Cookie Policy.</strong></p>
      </div>
    </div>
  </div>
</PageTemplate>

<style>
  .cookies-page {
    background: #F5F5F7;
    min-height: calc(100vh - 48px);
    padding: 60px 20px 80px;
  }

  .cookies-container {
    max-width: 800px;
    margin: 0 auto;
    background: white;
    padding: 60px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .cookies-container h1 {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #1D1D1F;
    margin: 0 0 12px 0;
  }

  .last-updated {
    font-size: 14px;
    color: rgba(60, 60, 67, 0.6);
    margin: 0 0 32px 0;
  }

  .cookies-intro {
    padding: 24px;
    background: rgba(88, 86, 214, 0.05);
    border-left: 3px solid #5856D6;
    border-radius: 8px;
    margin-bottom: 48px;
  }

  .cookies-intro p {
    margin: 0 0 12px 0;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(60, 60, 67, 0.85);
  }

  .cookies-intro p:last-child {
    margin-bottom: 0;
  }

  .cookies-section {
    margin-bottom: 48px;
  }

  .cookies-section:last-child {
    margin-bottom: 0;
  }

  .cookies-section h2 {
    font-size: 28px;
    font-weight: 700;
    color: #1D1D1F;
    margin: 0 0 20px 0;
    padding-top: 8px;
  }

  .cookies-section h3 {
    font-size: 20px;
    font-weight: 600;
    color: #1D1D1F;
    margin: 24px 0 12px 0;
  }

  .cookies-section p {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(60, 60, 67, 0.85);
    margin: 0 0 16px 0;
  }

  .cookies-section ul {
    margin: 0 0 16px 0;
    padding-left: 24px;
  }

  .cookies-section li {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(60, 60, 67, 0.85);
    margin-bottom: 8px;
  }

  .cookies-section a {
    color: #007AFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cookies-section a:hover {
    color: #0051D5;
    text-decoration: underline;
  }

  /* Cookie Tables */
  .cookie-table {
    margin: 20px 0;
    overflow-x: auto;
  }

  .cookie-table table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    overflow: hidden;
  }

  .cookie-table th {
    background: #F5F5F7;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    color: #1D1D1F;
    border-bottom: 2px solid rgba(0, 0, 0, 0.1);
  }

  .cookie-table td {
    padding: 12px 16px;
    font-size: 14px;
    color: rgba(60, 60, 67, 0.85);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .cookie-table tr:last-child td {
    border-bottom: none;
  }

  .cookie-table tbody tr:hover {
    background: rgba(0, 122, 255, 0.02);
  }

  /* Contact Info */
  .contact-info {
    background: #F5F5F7;
    padding: 20px;
    border-radius: 8px;
    margin: 16px 0;
  }

  .contact-info p {
    margin: 0 0 8px 0;
  }

  .contact-info p:last-child {
    margin-bottom: 0;
  }

  /* Warning Box */
  .warning-box {
    background: rgba(255, 149, 0, 0.08);
    border-left: 3px solid #FF9500;
    padding: 16px 20px;
    border-radius: 8px;
    margin: 20px 0;
  }

  .warning-box p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(60, 60, 67, 0.9);
  }

  /* Cookie Preferences Link */
  .cookie-preferences-link {
    margin: 20px 0;
    text-align: center;
  }

  .manage-cookies-btn {
    background: #007AFF;
    color: white;
    border: none;
    padding: 14px 32px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .manage-cookies-btn:hover {
    background: #0051D5;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
  }

  /* Acknowledgment Box */
  .cookies-acknowledgment {
    margin-top: 48px;
    padding: 24px;
    background: rgba(88, 86, 214, 0.05);
    border: 2px solid #5856D6;
    border-radius: 12px;
    text-align: center;
  }

  .cookies-acknowledgment p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #1D1D1F;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .cookies-page {
      padding: 40px 20px 60px;
    }

    .cookies-container {
      padding: 32px 24px;
      border-radius: 12px;
    }

    .cookies-container h1 {
      font-size: 36px;
    }

    .cookies-section h2 {
      font-size: 24px;
    }

    .cookies-section h3 {
      font-size: 18px;
    }

    .cookies-section p,
    .cookies-section li {
      font-size: 15px;
    }

    .cookie-table {
      font-size: 13px;
    }

    .cookie-table th,
    .cookie-table td {
      padding: 10px 12px;
      font-size: 13px;
    }
  }
</style>

<script>
  function openCookiePreferences() {
    // This would open your cookie consent banner/modal
    // For now, just an alert
    alert('Cookie Preference Center will be implemented here. This would open a modal where users can accept/reject different cookie categories.');
    
    // In production, you would integrate with a cookie consent solution like:
    // - OneTrust
    // - Cookiebot
    // - Osano
    // - Or build your own preference center
  }
</script>