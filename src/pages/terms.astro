</PageTemplate>

<style>
  .terms-page {
    background: #F5F5F7;
    min-height: calc(100vh - 48px);
    padding: 60px 20px 80px;
  }

  .terms-container {
    max-width: 800px;
    margin: 0 auto;
    background: white;
    padding: 60px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .terms-container h1 {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #1D1D1F;
    margin: 0 0 12px 0;
  }

  .last-updated {
    font-size: 14px;
    color: rgba(60, 60, 67, 0.6);
    margin: 0 0 32px 0;
  }

  .terms-intro {
    padding: 24px;
    background: rgba(255, 149, 0, 0.05);
    border-left: 3px solid #FF9500;
    border-radius: 8px;
    margin-bottom: 48px;
  }

  .terms-intro p {
    margin: 0 0 12px 0;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(60, 60, 67, 0.85);
  }

  .terms-intro p:last-child {
    margin-bottom: 0;
  }

  .terms-section {
    margin-bottom: 48px;
  }

  .terms-section:last-child {
    margin-bottom: 0;
  }

  .terms-section h2 {
    font-size: 28px;
    font-weight: 700;
    color: #1D1D1F;
    margin: 0 0 20px 0;
    padding-top: 8px;
  }

  .terms-section h3 {
    font-size: 20px;
    font-weight: 600;
    color: #1D1D1F;
    margin: 24px 0 12px 0;
  }

  .terms-section p {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(60, 60, 67, 0.85);
    margin: 0 0 16px 0;
  }

  .terms-section ul {
    margin: 0 0 16px 0;
    padding-left: 24px;
  }

  .terms-section li {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(60, 60, 67, 0.85);
    margin-bottom: 8px;
  }

  .terms-section a {
    color: #007AFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .terms-section a:hover {
    color: #0051D5;
    text-decoration: underline;
  }

  .contact-info {
    background: #F5F5F7;
    padding: 20px;
    border-radius: 8px;
    margin: 16px 0;
  }

  .contact-info p {
    margin: 0 0 8px 0;
  }

  .contact-info p:last-child {
    margin-bottom: 0;
  }

  .terms-acknowledgment {
    margin-top: 48px;
    padding: 24px;
    background: rgba(0, 122, 255, 0.05);
    border: 2px solid #007AFF;
    border-radius: 12px;
    text-align: center;
  }

  .terms-acknowledgment p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #1D1D1F;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .terms-page {
      padding: 40px 20px 60px;
    }

    .terms-container {
      padding: 32px 24px;
      border-radius: 12px;
    }

    .terms-container h1 {
      font-size: 36px;
    }

    .terms-section h2 {
      font-size: 24px;
    }

    .terms-section h3 {
      font-size: 18px;
    }

    .terms-section p,
    .terms-section li {
      font-size: 15px;
    }
  }
</style>