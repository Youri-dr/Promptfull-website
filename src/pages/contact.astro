---
// src/pages/contact.astro
import PageTemplate from '../layouts/PageTemplate.astro';
---

<PageTemplate 
  title="Contact Us" 
  description="Get in touch with the Promptfull team. We'd love to hear from you."
  maxWidth="800px"
>
  <div class="contact-page">
    <!-- Hero Section -->
    <div class="contact-hero">
      <h1 class="contact-headline">Let's Talk</h1>
      <p class="contact-intro">
        Have a question, idea, or just want to say hi? Drop us a message and we'll get back to you within 24 hours.
      </p>
    </div>

    <!-- Contact Form Card -->
    <div class="contact-card">
      <!-- Success Message (hidden by default) -->
      <div class="contact-success" id="contact-success" style="display: none;">
        <div class="success-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="32" fill="#10B981" fill-opacity="0.1"/>
            <path d="M20 32l8 8 16-16" stroke="#10B981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2>Message Received!</h2>
        <p>Thanks for reaching out. We'll get back to you soon.</p>
      </div>

      <!-- Cooldown Message (hidden by default) -->
      <div class="contact-cooldown" id="contact-cooldown" style="display: none;">
        <div class="cooldown-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="32" fill="#F59E0B" fill-opacity="0.1"/>
            <circle cx="32" cy="32" r="30" stroke="#F59E0B" stroke-width="2" fill="none"/>
            <path d="M32 20v12l8 8" stroke="#F59E0B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2>Hold On a Moment</h2>
        <p>You've recently submitted a message. Please wait <strong id="cooldown-time">5 minutes</strong> before sending another one.</p>
      </div>

      <!-- Contact Form -->
      <form class="contact-form" id="contact-form">
        <!-- Honeypot field (hidden from humans, visible to bots) -->
        <input 
          type="text" 
          name="website" 
          id="website" 
          tabindex="-1" 
          autocomplete="off"
          style="position: absolute; left: -9999px; width: 1px; height: 1px;"
          aria-hidden="true"
        />

        <!-- Name Field -->
        <div class="form-group">
          <label for="name">Your Name <span class="required">*</span></label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            placeholder="Jane Doe"
            autocomplete="name"
          />
        </div>

        <!-- Email Field -->
        <div class="form-group">
          <label for="email">Email Address <span class="required">*</span></label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="jane@example.com"
            autocomplete="email"
          />
        </div>

        <!-- Topic Dropdown -->
        <div class="form-group">
          <label for="topic">What's this about? <span class="required">*</span></label>
          <select id="topic" name="topic" required>
            <option value="">Select a topic</option>
            <option value="general">General Question</option>
            <option value="partnership">Partnership Opportunity</option>
            <option value="press">Press Inquiry</option>
            <option value="feedback">Feedback</option>
            <option value="support">Support</option>
            <option value="other">Other</option>
          </select>
        </div>

        <!-- Message Field -->
        <div class="form-group">
          <label for="message">Your Message <span class="required">*</span></label>
          <textarea 
            id="message" 
            name="message" 
            required 
            rows="6"
            placeholder="Tell us what's on your mind..."
          ></textarea>
        </div>

        <!-- Error Message -->
        <div class="form-error" id="form-error" style="display: none;"></div>

        <!-- Submit Button -->
        <button type="submit" class="submit-button" id="submit-button">
          <span class="button-text">Send Message</span>
          <span class="button-loading" style="display: none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="12" r="10" stroke-width="3" stroke-opacity="0.25"/>
              <path d="M12 2a10 10 0 0 1 10 10" stroke-width="3" stroke-linecap="round"/>
            </svg>
            Sending...
          </span>
        </button>
      </form>
    </div>
  </div>
</PageTemplate>

<style>
  .contact-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 60px 20px 80px;
  }

  /* Hero Section */
  .contact-hero {
    text-align: center;
    margin-bottom: 48px;
  }

  .contact-headline {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #1F2937;
    margin: 0 0 16px 0;
  }

  .contact-intro {
    font-size: 18px;
    line-height: 1.6;
    color: #6B7280;
    margin: 0;
    max-width: 540px;
    margin: 0 auto;
  }

  /* Contact Card */
  .contact-card {
    background: white;
    border-radius: 24px;
    padding: 48px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  /* Success State */
  .contact-success,
  .contact-cooldown {
    text-align: center;
    padding: 40px 20px;
  }

  .success-icon,
  .cooldown-icon {
    margin: 0 auto 24px;
    width: 64px;
    height: 64px;
  }

  .success-icon svg,
  .cooldown-icon svg {
    animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .contact-success h2,
  .contact-cooldown h2 {
    font-size: 28px;
    font-weight: 700;
    color: #1F2937;
    margin: 0 0 12px 0;
  }

  .contact-success p,
  .contact-cooldown p {
    font-size: 16px;
    line-height: 1.6;
    color: #6B7280;
    margin: 0;
  }

  /* Form Styles */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 600;
    color: #374151;
  }

  .required {
    color: #EF4444;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: inherit;
    font-size: 16px;
    padding: 12px 16px;
    border: 1.5px solid #E5E7EB;
    border-radius: 12px;
    background: white;
    color: #1F2937;
    transition: all 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #3B82F6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  .form-group select {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%236B7280' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 44px;
  }

  /* Error Message */
  .form-error {
    padding: 12px 16px;
    background: #FEE2E2;
    border: 1px solid #EF4444;
    border-radius: 12px;
    color: #991B1B;
    font-size: 14px;
    font-weight: 500;
  }

  /* Submit Button */
  .submit-button {
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    padding: 14px 32px;
    background: #3B82F6;
    color: white;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .submit-button:hover {
    background: #2563EB;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .submit-button:active {
    transform: translateY(0);
  }

  .submit-button:disabled {
    background: #9CA3AF;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .button-loading svg {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Mobile Styles */
  @media (max-width: 640px) {
    .contact-page {
      padding: 40px 20px 60px;
    }

    .contact-headline {
      font-size: 36px;
    }

    .contact-intro {
      font-size: 16px;
    }

    .contact-card {
      padding: 32px 24px;
      border-radius: 20px;
    }

    .contact-hero {
      margin-bottom: 32px;
    }

    .contact-success h2,
    .contact-cooldown h2 {
      font-size: 24px;
    }
  }
</style>

<script>
  // Constants
  const COOLDOWN_DURATION = 5 * 60 * 1000; // 5 minutes in milliseconds
  const COOLDOWN_KEY = 'contact_form_cooldown';

  // Elements
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successDiv = document.getElementById('contact-success') as HTMLDivElement;
  const cooldownDiv = document.getElementById('contact-cooldown') as HTMLDivElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const buttonText = submitButton?.querySelector('.button-text') as HTMLSpanElement;
  const buttonLoading = submitButton?.querySelector('.button-loading') as HTMLSpanElement;

  // Check cooldown on page load
  checkCooldown();

  // Form submission handler
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Hide any previous errors
    errorDiv.style.display = 'none';

    // Check honeypot (spam trap)
    const honeypot = (document.getElementById('website') as HTMLInputElement)?.value;
    if (honeypot) {
      console.log('Spam detected (honeypot filled)');
      return; // Silently reject (don't tell spammers)
    }

    // Check cooldown
    if (isCooldownActive()) {
      showCooldown();
      return;
    }

    // Get form data
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      topic: formData.get('topic'),
      message: formData.get('message'),
      timestamp: new Date().toISOString()
    };

    // Validate email format
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailPattern.test(data.email as string)) {
      showError('Please enter a valid email address.');
      return;
    }

    // Show loading state
    submitButton.disabled = true;
    buttonText.style.display = 'none';
    buttonLoading.style.display = 'flex';

    // Simulate submission (replace this with actual email service later)
    try {
      // Log to console for now (you'll replace this with actual API call)
      console.log('📧 Contact Form Submission:', data);
      
      // TODO: Replace with actual email service
      // Example with Formspree:
      // const response = await fetch('https://formspree.io/f/YOUR_FORM_ID', {
      //   method: 'POST',
      //   body: JSON.stringify(data),
      //   headers: { 'Content-Type': 'application/json' }
      // });
      
      // Simulate network delay
      await new Promise(resolve => setTimeout(resolve, 1000));

      // Set cooldown
      setCooldown();

      // Show success message
      showSuccess();

    } catch (error) {
      console.error('Submission error:', error);
      showError('Something went wrong. Please try again.');
      
      // Reset button
      submitButton.disabled = false;
      buttonText.style.display = 'block';
      buttonLoading.style.display = 'none';
    }
  });

  // Helper Functions
  function isCooldownActive(): boolean {
    const cooldownEnd = localStorage.getItem(COOLDOWN_KEY);
    if (!cooldownEnd) return false;
    
    const now = Date.now();
    const endTime = parseInt(cooldownEnd);
    
    return now < endTime;
  }

  function setCooldown(): void {
    const endTime = Date.now() + COOLDOWN_DURATION;
    localStorage.setItem(COOLDOWN_KEY, endTime.toString());
  }

  function checkCooldown(): void {
    if (isCooldownActive()) {
      showCooldown();
      updateCooldownTimer();
    }
  }

  function updateCooldownTimer(): void {
    const cooldownEnd = localStorage.getItem(COOLDOWN_KEY);
    if (!cooldownEnd) return;

    const interval = setInterval(() => {
      const now = Date.now();
      const endTime = parseInt(cooldownEnd);
      const remaining = endTime - now;

      if (remaining <= 0) {
        clearInterval(interval);
        location.reload(); // Refresh to show form again
        return;
      }

      const minutes = Math.floor(remaining / 60000);
      const seconds = Math.floor((remaining % 60000) / 1000);
      
      const timeElement = document.getElementById('cooldown-time');
      if (timeElement) {
        timeElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
      }
    }, 1000);
  }

  function showSuccess(): void {
    form.style.display = 'none';
    successDiv.style.display = 'block';
  }

  function showCooldown(): void {
    form.style.display = 'none';
    cooldownDiv.style.display = 'block';
    updateCooldownTimer();
  }

  function showError(message: string): void {
    errorDiv.textContent = message;
    errorDiv.style.display = 'block';
    
    // Scroll to error
    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
</script>