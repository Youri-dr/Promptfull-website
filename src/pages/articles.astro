---
import PageTemplate from "../layouts/PageTemplate.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticles, getImageUrl, formatReadingTime, formatPublishDate } from "../lib/directus";

// Fetch all published articles from Directus
const allArticles = await getArticles();

// Transform to match component format
const transformedArticles = allArticles.map(article => ({
  id: article.slug,
  title: article.title,
  subtitle: article.excerpt,
  category: article.category,
  categoryColorHex: article.category_color || "#7C5CFF",
  readTime: formatReadingTime(article.reading_time),
  relativeDateLabel: formatPublishDate(article.publish_at),
  publishDate: formatPublishDate(article.publish_at),
  imageURL: article.cover_image ? getImageUrl(article.cover_image.id) : null,
}));
---

<PageTemplate title="All Articles" description="In-depth guides on AI prompts, design, and productivity.">
  <div class="articles-page">
    <!-- Page header -->
    <header class="page-header">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M19 12H5m7 7l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Back to Home</span>
      </a>
      
      <h1 class="page-title">All Articles</h1>
      <p class="page-subtitle">In-depth guides on AI prompts, design, and productivity.</p>

      <!-- Search bar -->
      <div class="search-wrapper">
        <div class="search-bar">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
            <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <input 
            type="search" 
            class="search-input" 
            placeholder="Search articles..."
            aria-label="Search articles"
          />
          <button class="clear-button" aria-label="Clear search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Articles grid -->
    <div class="articles-grid">
      {transformedArticles.map((article) => (
        <div class="article-item" data-title={article.title.toLowerCase()} data-category={article.category.toLowerCase()}>
          <ArticleCard article={article} />
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div class="no-results" style="display: none;">
      <p>No articles found. Try a different search term.</p>
    </div>
  </div>
</PageTemplate>

<style>
  .articles-page {
    max-width: 1060px;
    margin: 0 auto;
  }

  /* Page header */
  .page-header {
    margin-bottom: 48px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    transition: opacity 0.2s ease;
    margin-bottom: 24px;
  }

  .back-link:hover {
    opacity: 0.7;
  }

  .page-title {
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 12px 0;
  }

  .page-subtitle {
    font-size: 21px;
    line-height: 1.4;
    color: var(--text-secondary);
    margin: 0 0 32px 0;
  }

  /* Search bar */
  .search-wrapper {
    max-width: 600px;
  }

  .search-bar {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(120, 120, 128, 0.12);
    border-radius: 12px;
    padding: 0 16px;
    transition: all 0.2s ease;
  }

  .search-bar:focus-within {
    background: rgba(120, 120, 128, 0.16);
    box-shadow: 0 0 0 4px rgba(0, 122, 255, 0.1);
  }

  .search-icon {
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 12px 12px 12px 12px;
    font-size: 17px;
    color: var(--text);
    outline: none;
    font-family: inherit;
  }

  .search-input::placeholder {
    color: var(--text-tertiary);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .clear-button {
    display: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.15);
    border: none;
    color: white;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .clear-button:hover {
    background: rgba(0, 0, 0, 0.25);
  }

  .clear-button:active {
    transform: scale(0.9);
  }

  .clear-button.visible {
    display: flex;
  }

  /* Articles grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .articles-grid :global(.pf-articlecard) {
    display: flex;
    flex-direction: column;
  }

  .article-item {
    transition: opacity 0.2s ease;
  }

  .article-item.hidden {
    display: none;
  }

  /* No results */
  .no-results {
    text-align: center;
    padding: 80px 20px;
  }

  .no-results p {
    font-size: 19px;
    color: var(--text-secondary);
  }

  /* Mobile: single column */
  @media (max-width: 820px) {
    .page-header {
      margin-bottom: 36px;
    }

    .page-title {
      font-size: 36px;
    }

    .page-subtitle {
      font-size: 19px;
      margin-bottom: 24px;
    }

    .search-input {
      font-size: 16px;
      padding: 11px 12px;
    }

    .articles-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 520px) {
    .page-title {
      font-size: 32px;
    }

    .page-subtitle {
      font-size: 17px;
    }

    .search-input {
      font-size: 15px;
    }

    .articles-grid {
      gap: 14px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.querySelector('.search-input') as HTMLInputElement;
    const clearButton = document.querySelector('.clear-button');
    const articleItems = document.querySelectorAll('.article-item');
    const noResults = document.querySelector('.no-results') as HTMLElement;

    if (!searchInput || !clearButton || !noResults) return;

    // Filter articles
    const filterArticles = () => {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      articleItems.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const category = item.getAttribute('data-category') || '';
        
        const matches = title.includes(query) || category.includes(query);
        
        if (matches) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      // Show/hide no results message
      if (visibleCount === 0 && query !== '') {
        noResults.style.display = 'block';
      } else {
        noResults.style.display = 'none';
      }

      // Show/hide clear button
      if (query !== '') {
        clearButton.classList.add('visible');
      } else {
        clearButton.classList.remove('visible');
      }
    };

    // Search on input
    searchInput.addEventListener('input', filterArticles);

    // Clear search
    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      filterArticles();
      searchInput.focus();
    });

    // Clear on ESC
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchInput.value = '';
        filterArticles();
        searchInput.blur();
      }
    });
  });
</script>