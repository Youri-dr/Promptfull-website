---
// src/pages/app.astro
import PageTemplate from '../layouts/PageTemplate.astro';
---
<PageTemplate 
  title="iOS App" 
  description="Master AI prompting with daily challenges and 100+ learning cards. Coming soon to iOS."
  noPadding={true}
>
<!-- Hero Section -->
<section class="app-hero">
<div class="app-hero-content">
<h1 class="app-hero-title">Master AI Prompting,<br/>One Card at a Time</h1>
<p class="app-hero-subtitle">Daily challenges that make learning natural. 100+ focused cards designed to build real understanding.</p>
<div class="app-hero-cta">
<a href="https://apps.apple.com" class="app-download-button" target="_blank" rel="noopener">
<svg width="20" height="24" viewBox="0 0 20 24" fill="currentColor">
<path d="M16.93 11.33c-.02-2.92 2.39-4.33 2.5-4.41-1.36-1.99-3.48-2.26-4.23-2.29-1.8-.18-3.51 1.06-4.42 1.06-.91 0-2.32-1.03-3.81-1-1.96.03-3.77 1.14-4.78 2.9-2.04 3.53-.52 8.76 1.46 11.63 1 1.4 2.18 2.97 3.73 2.92 1.51-.06 2.08-.98 3.91-.98 1.82 0 2.34.98 3.81.95 1.57-.03 2.64-1.43 3.63-2.84 1.15-1.63 1.62-3.21 1.65-3.29-.04-.01-3.16-1.21-3.19-4.8l-.26.25z"/>
<path d="M13.95 3.31c.83-1 1.39-2.39 1.24-3.78-1.2.05-2.65.8-3.51 1.8-.77.89-1.44 2.31-1.26 3.67 1.33.1 2.69-.68 3.53-1.69z"/>
</svg>
<span>
<small>Download on the</small>
<strong>App Store</strong>
</span>
</a>
</div>
</div>
<!-- Hero Visual -->
<div class="app-hero-visual">
  <div class="app-favicon-wrapper">
    <img src="/images/promptfull-favicon.svg" alt="Promptfull App Icon" class="app-favicon-img" />
  </div>
</div>
</section>
<!-- Scroll Hint -->
<div class="scroll-hint-section">
<span>Discover more</span>
<div class="scroll-hint-arrow">↓</div>
</div>
<!-- Features with Parallax Phone -->
<section class="app-features-wrapper">
<!-- Parallax Phone (centered, sticky) -->
<div class="app-phone-sticky-container">
<div class="app-phone-frame">
<div class="app-phone-screen" id="parallaxScreen">
<img src="/images/Screenshot_OpeningApp.png" alt="Promptfull App" style="width:100%;height:100%;object-fit:cover;" />
</div>
</div>
</div>
<!-- Feature 1: AI Learning Cards -->
<div class="app-feature" data-screen="cards">
<div class="app-feature-content">
<span class="app-feature-label">AI Learning Cards</span>
<h2 class="app-feature-title">Learn One Insight at a Time</h2>
<p class="app-feature-text">
          100+ focused learning cards designed to teach you AI prompting through clear examples and practical insights. Each card is crafted to build real understanding, not just memorization.
</p>
<ul class="app-feature-list">
<li>Bite-sized lessons that stick</li>
<li>Real-world examples</li>
<li>Progressive difficulty</li>
<li>Track your progress</li>
</ul>
</div>
</div>
<!-- Feature 2: Daily Challenges -->
<div class="app-feature" data-screen="challenges">
<div class="app-feature-content">
<span class="app-feature-label">Daily Practice</span>
<h2 class="app-feature-title">Practice Without Pressure</h2>
<p class="app-feature-text">
          Daily challenges designed to reinforce what you've learned. Small steps, real progress. Build the habit of better prompting naturally, one day at a time.
</p>
<ul class="app-feature-list">
<li>New challenge every day</li>
<li>No streaks, no stress</li>
<li>Learn at your own pace</li>
<li>See your improvement</li>
</ul>
</div>
</div>
<!-- Feature 3: Community -->
<div class="app-feature" data-screen="community">
<div class="app-feature-content">
<span class="app-feature-label">Community</span>
<h2 class="app-feature-title">Join the Community</h2>
<p class="app-feature-text">
          Learn alongside thousands of AI enthusiasts. Share your progress, discover what's popular, and see how others are mastering prompting. Learning is better together.
</p>
<ul class="app-feature-list">
<li>See what's trending</li>
<li>Share your achievements</li>
<li>Learn from the community</li>
<li>Connect with fellow learners</li>
</ul>
</div>
</div>
<!-- Feature 4: Home -->
<div class="app-feature" data-screen="home">
<div class="app-feature-content">
<span class="app-feature-label">Your Home</span>
<h2 class="app-feature-title">Everything in One Place</h2>
<p class="app-feature-text">
          Your personal AI learning hub. Pick up where you left off, track your progress, and discover what to learn next — all from one clean, focused home screen.
</p>
<ul class="app-feature-list">
<li>Resume where you stopped</li>
<li>Track your streaks</li>
<li>Discover new content</li>
<li>Stay on top of your learning</li>
</ul>
</div>
</div>
</section>
<!-- Final CTA Section -->
<section class="app-final-cta">
<div class="app-final-content">
<h2 class="app-final-title">Ready to Start Learning?</h2>
<p class="app-final-subtitle">Join the waiting list and be the first to know when we launch.</p>
<a href="https://apps.apple.com" class="app-download-button large" target="_blank" rel="noopener">
<svg width="24" height="28" viewBox="0 0 20 24" fill="currentColor">
<path d="M16.93 11.33c-.02-2.92 2.39-4.33 2.5-4.41-1.36-1.99-3.48-2.26-4.23-2.29-1.8-.18-3.51 1.06-4.42 1.06-.91 0-2.32-1.03-3.81-1-1.96.03-3.77 1.14-4.78 2.9-2.04 3.53-.52 8.76 1.46 11.63 1 1.4 2.18 2.97 3.73 2.92 1.51-.06 2.08-.98 3.91-.98 1.82 0 2.34.98 3.81.95 1.57-.03 2.64-1.43 3.63-2.84 1.15-1.63 1.62-3.21 1.65-3.29-.04-.01-3.16-1.21-3.19-4.8l-.26.25z"/>
<path d="M13.95 3.31c.83-1 1.39-2.39 1.24-3.78-1.2.05-2.65.8-3.51 1.8-.77.89-1.44 2.31-1.26 3.67 1.33.1 2.69-.68 3.53-1.69z"/>
</svg>
<span>
<small>Download on the</small>
<strong>App Store</strong>
</span>
</a>
</div>

</section>
</PageTemplate>

<style>
/* ─── APP FAVICON ────────────────────────────────────────────── */
.app-hero-visual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.app-favicon-wrapper {
  display: inline-flex;
  padding: 24px;
  background: #fff;
  border-radius: 32px;
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
}

.app-favicon-img {
  width: 160px;
  height: 160px;
  display: block;
}

/* Hero Section */
.app-hero {
position: relative;
max-width: 1060px;
margin: 0 auto;
padding: 80px 20px 100px;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 60px;
align-items: center;
  }
.app-hero-title {
font-size: 56px;
font-weight: 800;
letter-spacing: -0.025em;
line-height: 1.1;
color: #1D1D1F;
margin: 0 0 24px 0;
  }
.app-hero-subtitle {
font-size: 21px;
line-height: 1.5;
color: rgba(60, 60, 67, 0.85);
margin: 0 0 40px 0;
  }
.app-hero-cta {
display: flex;
flex-direction: column;
gap: 16px;
align-items: flex-start;
  }
.app-download-button {
display: inline-flex;
align-items: center;
gap: 12px;
padding: 12px 24px;
background: #000;
color: #fff;
text-decoration: none;
border-radius: 12px;
transition: all 0.2s ease;
font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  }
.app-download-button:hover {
background: #1D1D1F;
transform: translateY(-2px);
box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
.app-download-button svg {
flex-shrink: 0;
  }
.app-download-button span {
display: flex;
flex-direction: column;
align-items: flex-start;
line-height: 1.2;
  }
.app-download-button small {
font-size: 11px;
font-weight: 400;
opacity: 0.8;
  }
.app-download-button strong {
font-size: 18px;
font-weight: 600;
  }
.app-download-button.large {
padding: 16px 32px;
  }
.app-download-button.large strong {
font-size: 22px;
  }

/* Scroll Hint Section */
.scroll-hint-section {
text-align: center;
padding: 40px 20px;
display: flex;
flex-direction: column;
align-items: center;
gap: 8px;
color: rgba(60, 60, 67, 0.7);
font-size: 15px;
font-weight: 500;
position: relative;
z-index: 10;
  }
.scroll-hint-arrow {
font-size: 24px;
animation: hintBounce 2s ease-in-out infinite;
  }
@keyframes hintBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

/* Features Wrapper with Parallax Phone */
.app-features-wrapper {
position: relative;
max-width: 1400px;
margin: -120px auto 0;
padding: 0 20px 80px;
  }
/* Parallax Phone - Centered and Sticky */
.app-phone-sticky-container {
position: sticky;
top: calc(100vh - 200px);
display: flex;
justify-content: center;
align-items: center;
height: 100vh;
pointer-events: none;
z-index: 1;
opacity: 1;
transition: top 0.3s ease, opacity 0.4s ease;
  }
.app-phone-sticky-container.scrolled { top: 0; }
.app-phone-sticky-container.hide { opacity: 0; }

.app-phone-frame {
width: 300px;
height: 600px;
background: #1D1D1F;
border-radius: 40px;
padding: 12px;
box-shadow: 0 20px 80px rgba(0, 0, 0, 0.3);
position: relative;
  }
.app-phone-frame::before {
content: '';
position: absolute;
top: 12px;
left: 50%;
transform: translateX(-50%);
width: 100px;
height: 20px;
background: #000;
border-radius: 0 0 12px 12px;
  }
.app-phone-screen {
width: 100%;
height: 100%;
background: #F5F5F7;
border-radius: 32px;
overflow: hidden;
position: relative;
  }

/* Feature Sections */
.app-feature {
position: relative;
min-height: 80vh;
display: flex;
align-items: center;
z-index: 2;
pointer-events: auto;
padding: 60px 0;
  }
.app-feature:first-of-type { padding-top: 80px; }
.app-feature:last-of-type { padding-bottom: 100px; }

.app-feature:nth-child(2) .app-feature-content {
margin-right: auto;
margin-left: 0;
max-width: 450px;
  }
.app-feature:nth-child(3) .app-feature-content {
margin-left: auto;
margin-right: 0;
max-width: 450px;
  }
.app-feature:nth-child(4) .app-feature-content {
margin-right: auto;
margin-left: 0;
max-width: 450px;
  }
.app-feature:nth-child(5) .app-feature-content {
margin-left: auto;
margin-right: 0;
max-width: 450px;
  }
.app-feature-content {
background: rgba(255, 255, 255, 0.95);
backdrop-filter: blur(20px);
-webkit-backdrop-filter: blur(20px);
padding: 48px;
border-radius: 24px;
box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
.app-feature-label {
display: inline-block;
font-size: 13px;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
color: var(--accent);
margin-bottom: 16px;
  }
.app-feature-title {
font-size: 42px;
font-weight: 800;
letter-spacing: -0.02em;
line-height: 1.2;
color: #1D1D1F;
margin: 0 0 20px 0;
  }
.app-feature-text {
font-size: 19px;
line-height: 1.5;
color: rgba(60, 60, 67, 0.85);
margin: 0 0 32px 0;
  }
.app-feature-list {
list-style: none;
padding: 0;
margin: 0;
  }
.app-feature-list li {
font-size: 17px;
color: rgba(60, 60, 67, 0.85);
padding: 10px 0 10px 32px;
position: relative;
  }
.app-feature-list li::before {
content: '✓';
position: absolute;
left: 0;
color: var(--accent);
font-weight: 700;
font-size: 18px;
  }

/* Final CTA */
.app-final-cta {
background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
padding: 120px 20px;
text-align: center;
color: white;
  }
.app-final-content {
max-width: 600px;
margin: 0 auto 60px;
  }
.app-final-title {
font-size: 48px;
font-weight: 800;
letter-spacing: -0.02em;
line-height: 1.1;
margin: 0 0 20px 0;
  }
.app-final-subtitle {
font-size: 21px;
line-height: 1.5;
opacity: 0.95;
margin: 0 0 40px 0;
  }


/* Tablet */
@media (max-width: 1024px) {
.app-phone-sticky-container { display: none; }
.app-features-wrapper { padding: 60px 20px; }
.app-feature { min-height: auto; margin-bottom: 60px; padding: 0; }
.app-feature:first-of-type { padding-top: 0; }
.app-feature:last-of-type { padding-bottom: 0; }
.app-feature:nth-child(2) .app-feature-content,
.app-feature:nth-child(3) .app-feature-content,
.app-feature:nth-child(4) .app-feature-content {
margin: 0 auto;
max-width: 100%;
    }
.app-feature-content { padding: 32px; }
  }

/* Mobile */
@media (max-width: 768px) {
.app-hero {
grid-template-columns: 1fr;
padding: 60px 20px 100px;
gap: 40px;
    }
.app-hero-title { font-size: 42px; }
.app-hero-subtitle { font-size: 19px; }
.app-feature-content { padding: 24px; }
.app-feature-title { font-size: 28px; }
.app-feature-text { font-size: 16px; }
.app-final-cta { padding: 80px 20px; }
.app-final-title { font-size: 36px; }
.app-final-subtitle { font-size: 19px; }
  }
</style>

<script>
function initParallaxScroll() {
const phoneContainer = document.querySelector('.app-phone-sticky-container') as HTMLElement;
const phoneScreen = document.getElementById('parallaxScreen') as HTMLElement;
const features = document.querySelectorAll('.app-feature');
const finalCTA = document.querySelector('.app-final-cta') as HTMLElement;
if (!phoneContainer || !phoneScreen || features.length === 0) return;

const screenContent: Record<string, string> = {
'cards':      `<img src="/images/Screenshot_AICards.png"       alt="AI Cards"        style="width:100%;height:100%;object-fit:cover;border-radius:32px;" />`,
'challenges': `<img src="/images/Screenshot_DailyChallenge.png"           alt="Daily Challenge" style="width:100%;height:100%;object-fit:cover;border-radius:32px;" />`,
'community':  `<img src="/images/Screenshot_Prompt.png"          alt="Community"       style="width:100%;height:100%;object-fit:cover;border-radius:32px;" />`,
'home':       `<img src="/images/Screenshot_Home.png"          alt="Home Screen"     style="width:100%;height:100%;object-fit:cover;border-radius:32px;" />`
};

// Show/hide phone based on scroll position relative to hero and CTA
function updatePhoneVisibility() {
const scrollY = window.scrollY;
if (scrollY > 200) {
phoneContainer.classList.add('scrolled');
} else {
phoneContainer.classList.remove('scrolled');
}
if (finalCTA) {
const ctaRect = finalCTA.getBoundingClientRect();
if (ctaRect.top < window.innerHeight * 0.4) {
phoneContainer.classList.add('hide');
} else {
phoneContainer.classList.remove('hide');
}
}
}

// Use IntersectionObserver to swap screenshot when feature is >40% visible
const observer = new IntersectionObserver((entries) => {
entries.forEach(entry => {
if (entry.isIntersecting) {
const screenType = (entry.target as HTMLElement).getAttribute('data-screen');
if (screenType && screenContent[screenType]) {
phoneScreen.innerHTML = screenContent[screenType];
}
}
});
}, {
threshold: 0.4
});

features.forEach(feature => observer.observe(feature));

// Reset to opener when hero is back in view
const hero = document.querySelector('.app-hero') as HTMLElement;
if (hero) {
const heroObserver = new IntersectionObserver((entries) => {
entries.forEach(entry => {
if (entry.isIntersecting) {
phoneScreen.innerHTML = `<img src="/images/Screenshot_OpeningApp.png" alt="Promptfull App" style="width:100%;height:100%;object-fit:cover;border-radius:32px;" />`;
}
});
}, { threshold: 0.1 });
heroObserver.observe(hero);
}

updatePhoneVisibility();
let ticking = false;
window.addEventListener('scroll', () => {
if (!ticking) {
window.requestAnimationFrame(() => {
updatePhoneVisibility();
ticking = false;
});
ticking = true;
}
});
window.addEventListener('resize', updatePhoneVisibility);
}
document.addEventListener('DOMContentLoaded', initParallaxScroll);
</script>
