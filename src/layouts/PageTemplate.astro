---
// src/layouts/PageTemplate.astro
import Navigation from '../components/Navigation.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  maxWidth?: string;
}

const { 
  title, 
  description = "Promptfull - Master AI prompting naturally",
  maxWidth = "1200px"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Promptfull</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <Navigation />
  
  <main class="page-main" style={`--max-width: ${maxWidth}`}>
    <slot />
  </main>
  
  <footer class="page-footer">
    <div class="footer-content">
      <div class="footer-brand">
        <strong>Promptfull</strong>
        <p>Master AI prompting, naturally.</p>
      </div>
      
      <div class="footer-links">
        <div class="footer-column">
          <h4>Product</h4>
          <ul>
            <li><a href="/app">iOS App</a></li>
            <li><a href="/articles">Articles</a></li>
            <li><a href="/ai-updates">AI Updates</a></li>
          </ul>
        </div>
        
        <div class="footer-column">
          <h4>Company</h4>
          <ul>
            <li><a href="/about">Our Story</a></li>
            <li><a href="/team">Team</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        
        <div class="footer-column">
          <h4>Legal</h4>
          <ul>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="/cookies">Cookies</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Promptfull. All rights reserved.</p>
    </div>
  </footer>
  
  <!-- Cookie Consent Banner -->
  <CookieConsent />
</body>
</html>

<style is:global>
  /* Reset & Base */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  :root {
    --text: rgba(0, 0, 0, 0.88);
    --text-secondary: rgba(60, 60, 67, 0.75);
    --accent: #007AFF;
    --accent-hover: #0069D9;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: var(--text);
    background: #F5F5F7;
    -webkit-font-smoothing: antialiased;
  }
  
  /* Page Main */
  .page-main {
    min-height: calc(100vh - 48px);
    background: #F5F5F7;
  }
  
  /* Footer */
  .page-footer {
    background: #1D1D1F;
    color: rgba(255, 255, 255, 0.92);
    padding: 60px 20px 32px;
  }
  
  .footer-content {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    margin-bottom: 48px;
  }
  
  .footer-brand strong {
    font-size: 20px;
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }
  
  .footer-brand p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
  }
  
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .footer-column h4 {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 12px;
  }
  
  .footer-column ul {
    list-style: none;
  }
  
  .footer-column a {
    display: block;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s ease;
  }
  
  .footer-column a:hover {
    color: rgba(255, 255, 255, 1);
  }
  
  .footer-bottom {
    max-width: 1060px;
    margin: 0 auto;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }
  
  .footer-bottom p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
  }
  
  /* Mobile Footer */
  @media (max-width: 768px) {
    .page-footer {
      padding: 48px 20px 24px;
    }
    
    .footer-content {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-bottom: 32px;
    }
    
    .footer-links {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>