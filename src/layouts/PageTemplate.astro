---
// src/layouts/PageTemplate.astro
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  maxWidth?: string;
  noPadding?: boolean;
}

const {
  title,
  description = "Promptfull - Master AI prompting naturally",
  maxWidth = "1200px",
  noPadding = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="color-scheme" content="only light" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Promptfull</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8681526049025910"
     crossorigin="anonymous"></script>
</head>
<body>
  <Navigation />
  <main class={`page-main${noPadding ? ' page-main--no-padding' : ''}`} style={`--max-width: ${maxWidth}`}>
    <slot />
  </main>
  <Footer />
  <CookieConsent />
</body>
</html>

<style is:global>
  /* Reset & Base */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    color-scheme: only light;
    --text: rgba(0, 0, 0, 0.88);
    --text-secondary: rgba(60, 60, 67, 0.75);
    --accent: #007AFF;
    --accent-hover: #0069D9;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: var(--text);
    background: #F5F5F7;
    -webkit-font-smoothing: antialiased;
  }

  /* Page Main — constrained pages (About, Articles, etc.) */
  .page-main {
    min-height: calc(100vh - 48px);
    background: #F5F5F7;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 52px 20px 80px;
    box-sizing: border-box;
  }

  /* Modal panels — override global body color cascade for all text inside */
  .modal-panel,
  .modal-panel p,
  .modal-panel h2,
  .modal-panel strong {
    color: #ffffff !important;
  }

  /* Full-width pages (App, Article detail) — no padding, no max-width */
  .page-main--no-padding {
    padding: 0 !important;
    max-width: 100% !important;
    min-height: 0 !important;
    background: transparent !important;
  }

  @media (max-width: 820px) {
    .page-main:not(.page-main--no-padding) {
      padding: 32px 16px 48px;
    }
  }

  @media (max-width: 520px) {
    .page-main:not(.page-main--no-padding) {
      padding: 28px 12px 40px;
    }
  }
</style>