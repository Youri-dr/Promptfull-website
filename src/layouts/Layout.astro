---
const { title = "Promptfull" } = Astro.props;
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Thoughtfully crafted prompts for AI" />
  <title>{title}</title>
  <!-- Apple-style meta tags -->
  <meta name="theme-color" content="#f5f5f7" />
  <meta name="color-scheme" content="only light" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8681526049025910"
     crossorigin="anonymous"></script>
</head>
<body>
  <Navigation />
  <main class="shell">
    <slot />
  </main>
  <Footer />
  <!-- Cookie Consent Banner -->
  <CookieConsent />
  <script src="/scripts/carousel.js" is:inline></script>
</body>
</html>

<style>
  /* Default shell for single-column pages */
  .shell {
    width: min(1060px, 92vw);
    margin: 0 auto;
    padding: 52px 0 80px;
  }

  /* Wider container for article pages with 2-column layout */
  .shell:has(.article-layout) {
    width: 85vw !important;
    max-width: 1200px !important;
  }

  /* Large desktop - even more whitespace for article pages */
  @media (min-width: 1400px) {
    .shell:has(.article-layout) {
      width: 80vw !important;
    }
  }

  /* Tablet adjustments */
  @media (max-width: 1280px) {
    .shell:has(.article-layout) {
      width: 88vw !important;
    }
  }

  @media (max-width: 1024px) {
    .shell {
      width: 88vw;
      padding: 48px 0 72px;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 820px) {
    .shell {
      width: 92vw;
      padding: 40px 0 64px;
    }
  }

  @media (max-width: 520px) {
    .shell {
      width: 90vw;
      padding: 32px 0 56px;
    }
  }
</style>